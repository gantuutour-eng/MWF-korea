---
import AppLayout from "../../layouts/AppLayout.astro";
import {
  listEvents,
  listPortfolioPrograms,
  listPortfolioStats,
} from "../../lib/db";
import { styleFor, formatDate } from "../../lib/eventStyles";
import { toneClasses } from "../../lib/portfolioStyles";

const env = Astro.locals.runtime.env;
const [stats, programs, pastEvents] = await Promise.all([
  listPortfolioStats(env.DB),
  listPortfolioPrograms(env.DB),
  listEvents(env.DB, { when: "past" }),
]);

const weekdayLabels = ["Ня", "Да", "Мя", "Лх", "Пү", "Ба", "Бя"];
function eventDateLine(unix: number): string {
  const d = new Date(unix * 1000);
  return `${formatDate(unix)} (${weekdayLabels[d.getDay()]})`;
}
---

<AppLayout title="Хийгдсэн ажлууд" showHeader={false}>
  <header
    class="px-3 pt-6 pb-3 flex items-center"
    data-purpose="portfolio-header"
  >
    <a href="/" aria-label="Буцах" class="p-2">
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M15 19l-7-7 7-7"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
    </a>
    <h1 class="flex-1 text-center text-lg font-bold">Хийгдсэн ажлууд</h1>
    <div class="w-10"></div>
  </header>

  <section class="px-5 mb-6" data-purpose="portfolio-hero">
    <div
      class="bg-mwa-burgundy text-white rounded-[24px] p-6 relative overflow-hidden min-h-[160px] flex flex-col justify-center"
    >
      <div class="absolute right-[-30px] top-[-20px] w-44 h-44 opacity-20">
        <svg viewBox="0 0 100 100" fill="none">
          <circle cx="50" cy="50" r="45" stroke="white" stroke-width="0.4" />
          <circle cx="50" cy="50" r="35" stroke="white" stroke-width="0.4" />
          <circle cx="50" cy="50" r="25" stroke="white" stroke-width="0.4" />
        </svg>
      </div>
      <div class="relative z-10">
        <span
          class="inline-block text-[11px] font-bold bg-white/20 backdrop-blur rounded-full px-3 py-1 mb-2"
        >
          2016 – 2026
        </span>
        <h2 class="text-2xl font-extrabold leading-tight mb-2">
          10 жилийн<br />тасралтгүй үйл ажиллагаа
        </h2>
        <p class="text-sm opacity-90 leading-snug">
          БНСУ дахь монгол эмэгтэйчүүдийн төлөө бид өдөр бүр ажиллаж байна.
        </p>
      </div>
    </div>
  </section>

  {
    stats.length > 0 && (
      <section class="px-5 mb-8" data-purpose="portfolio-stats">
        <div class="grid grid-cols-2 gap-3">
          {stats.map((s) => {
            const tc = toneClasses(s.tone);
            return (
              <div class={`rounded-2xl p-4 text-center ${tc.stat}`}>
                <div class="text-2xl font-extrabold">{s.value}</div>
                <div class="text-xs text-mwa-text-secondary mt-1 font-medium">
                  {s.label}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )
  }

  {
    programs.length > 0 && (
      <section class="px-5 mb-8" data-purpose="portfolio-programs">
        <h2 class="font-bold text-base mb-3">Гол хөтөлбөрүүд</h2>
        <div class="space-y-3">
          {programs.map((p) => {
            const tc = toneClasses(p.tone);
            return (
              <article class="bg-white border border-gray-100 rounded-2xl shadow-sm p-4">
                <div class="flex items-start gap-3">
                  <div
                    class={`w-12 h-12 rounded-xl flex items-center justify-center text-xl shrink-0 overflow-hidden ${tc.icon}`}
                  >
                    {p.image_url ? (
                      <img
                        src={p.image_url}
                        alt=""
                        class="w-full h-full object-cover"
                      />
                    ) : (
                      <span>{p.icon}</span>
                    )}
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1 flex-wrap">
                      <h3 class="font-bold text-sm">{p.title}</h3>
                      {p.since_label && (
                        <span class="text-[10px] text-gray-400 font-medium">
                          · {p.since_label}
                        </span>
                      )}
                    </div>
                    <p class="text-xs text-mwa-text-secondary leading-relaxed whitespace-pre-line">
                      {p.description}
                    </p>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )
  }

  {
    pastEvents.length > 0 && (
      <section class="px-5 mb-8" data-purpose="portfolio-past">
        <h2 class="font-bold text-base mb-3">Өнгөрсөн арга хэмжээ</h2>
        <div class="divide-y divide-gray-100">
          {pastEvents.map((row) => {
            const s = styleFor(row.type);
            return (
              <a
                href={`/events/${row.id}`}
                class="flex items-center gap-3 py-3"
              >
                <div class="w-16 h-16 shrink-0 rounded-xl overflow-hidden bg-gray-100">
                  {row.image_url ? (
                    <img
                      src={row.image_url}
                      alt=""
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full bg-mwa-burgundy/10 flex items-center justify-center text-mwa-burgundy/40 text-[10px]">
                      MWA
                    </div>
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <span
                    class={`inline-block text-[10px] font-bold px-1.5 py-0.5 rounded ${s.chip}`}
                  >
                    {s.label}
                  </span>
                  <h3 class="font-semibold text-sm leading-tight mt-1 line-clamp-1">
                    {row.title}
                  </h3>
                  <div class="text-[11px] text-gray-500 mt-0.5">
                    📅 {eventDateLine(row.start_at)}
                  </div>
                </div>
                <svg
                  class="w-4 h-4 text-gray-300 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M9 5l7 7-7 7"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  <section class="px-5 mb-10" data-purpose="portfolio-cta">
    <div class="bg-gray-50 rounded-2xl p-5 text-center">
      <p class="text-sm text-mwa-text-secondary mb-3 leading-relaxed">
        Дараагийн 10 жилд бид танаар бахархах болно.<br />
        Бидэнтэй нэгдээрэй.
      </p>
      <a
        href="/membership"
        class="inline-block bg-mwa-burgundy text-white font-bold text-sm rounded-2xl px-6 py-3 active:opacity-80"
      >
        Гишүүнчлэлд элсэх →
      </a>
    </div>
  </section>
</AppLayout>
