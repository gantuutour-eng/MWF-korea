---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminPaymentsTabs from "../../../components/AdminPaymentsTabs.astro";
import {
  listAllMembershipPaymentsWithUser,
  getPaymentSummary,
} from "../../../lib/db";
import { loadAdmin } from "../../../lib/adminAuth";
import { formatTugrik, getPlan } from "../../../lib/membership";

const env = Astro.locals.runtime.env;
const me = await loadAdmin(
  env.DB,
  env.SESSIONS,
  Astro.request.headers.get("cookie"),
);
if (!me) return Astro.redirect("/profile/login?next=/admin/payments");

const filter = Astro.url.searchParams.get("status");
const validFilter =
  filter === "pending" || filter === "confirmed" || filter === "rejected"
    ? filter
    : undefined;
const q = (Astro.url.searchParams.get("q") ?? "").trim();

const [rows, summary] = await Promise.all([
  listAllMembershipPaymentsWithUser(env.DB, validFilter),
  getPaymentSummary(env.DB),
]);

const qLower = q.toLowerCase();
const filtered = q
  ? rows.filter((p) => {
      return (
        p.reference.toLowerCase().includes(qLower) ||
        (p.customer_memo ?? "").toLowerCase().includes(qLower) ||
        (p.user_name ?? "").toLowerCase().includes(qLower) ||
        (p.user_email ?? "").toLowerCase().includes(qLower) ||
        (p.user_phone ?? "").toLowerCase().includes(qLower)
      );
    })
  : rows;

const tabs = [
  { key: "all", label: "Бүгд", href: buildHref(undefined) },
  { key: "pending", label: `Хүлээгдэж буй (${summary.pending_count})`, href: buildHref("pending") },
  { key: "confirmed", label: "Баталгаажсан", href: buildHref("confirmed") },
  { key: "rejected", label: "Татгалзсан", href: buildHref("rejected") },
];
const activeTab = validFilter ?? "all";

function buildHref(status: string | undefined): string {
  const params = new URLSearchParams();
  if (status) params.set("status", status);
  if (q) params.set("q", q);
  const qs = params.toString();
  return qs ? `/admin/payments?${qs}` : "/admin/payments";
}

function fmtDateTime(unix: number): string {
  const d = new Date(unix * 1000);
  const pad = (n: number) => String(n).padStart(2, "0");
  return `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

function fmtDate(unix: number): string {
  const d = new Date(unix * 1000);
  const pad = (n: number) => String(n).padStart(2, "0");
  return `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())}`;
}

const statusBadge: Record<string, string> = {
  pending: "bg-amber-50 text-amber-700 border border-amber-200",
  confirmed: "bg-emerald-50 text-emerald-700 border border-emerald-200",
  rejected: "bg-rose-50 text-rose-600 border border-rose-200",
};
const statusLabel: Record<string, string> = {
  pending: "Хүлээгдэж буй",
  confirmed: "Баталгаажсан",
  rejected: "Татгалзсан",
};
---

<AdminLayout title="Төлбөрийн удирдлага" active="payments">
  <header
    class="lg:hidden px-3 pt-6 pb-3 flex items-center bg-white border-b border-gray-100 sticky top-0 z-20"
  >
    <a href="/admin" aria-label="Буцах" class="p-2">
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
      </svg>
    </a>
    <h1 class="flex-1 text-center text-lg font-bold">Төлбөрийн удирдлага</h1>
    <div class="w-10"></div>
  </header>

  <div class="max-w-6xl mx-auto lg:px-8 lg:py-8">
    <h1 class="hidden lg:block text-2xl font-extrabold mb-6">Төлбөрийн удирдлага</h1>

    <AdminPaymentsTabs active="orders" />

    {/* ---------- Summary cards ---------- */}
    <section class="px-5 lg:px-0 grid grid-cols-2 lg:grid-cols-4 gap-2 mb-4">
      <div class="bg-amber-50 border border-amber-100 rounded-2xl p-3">
        <div class="text-[10px] text-amber-700 font-bold uppercase tracking-wider">
          Хүлээгдэж буй
        </div>
        <div class="text-xl font-extrabold text-amber-700 mt-1">
          {summary.pending_count}
        </div>
        <div class="text-[11px] text-amber-700/80">
          {formatTugrik(summary.pending_amount)}
        </div>
      </div>
      <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-3">
        <div class="text-[10px] text-emerald-700 font-bold uppercase tracking-wider">
          Идэвхтэй гишүүд
        </div>
        <div class="text-xl font-extrabold text-emerald-700 mt-1">
          {summary.active_members}
        </div>
        <div class="text-[11px] text-emerald-700/80">одоо</div>
      </div>
      <div class="bg-mwa-burgundy/5 border border-mwa-burgundy/20 rounded-2xl p-3">
        <div class="text-[10px] text-mwa-burgundy font-bold uppercase tracking-wider">
          Энэ сар
        </div>
        <div class="text-xl font-extrabold text-mwa-burgundy mt-1">
          {formatTugrik(summary.this_month_amount)}
        </div>
        <div class="text-[11px] text-mwa-text-secondary">баталгаажсан</div>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-3">
        <div class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">
          Нийт төлбөр
        </div>
        <div class="text-xl font-extrabold text-mwa-text-primary mt-1">
          {formatTugrik(summary.confirmed_amount)}
        </div>
        <div class="text-[11px] text-gray-500">{summary.confirmed_count} захиалга</div>
      </div>
    </section>

    {/* ---------- Search ---------- */}
    <form
      class="px-5 lg:px-0 mb-3"
      method="get"
      action="/admin/payments"
    >
      {validFilter && <input type="hidden" name="status" value={validFilter} />}
      <div class="relative">
        <svg
          class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
        </svg>
        <input
          name="q"
          type="search"
          value={q}
          placeholder="Нэр, имэйл, утас, лавлагаа эсвэл гүйлгээний утгаар хайх"
          class="w-full bg-white border border-gray-200 rounded-xl pl-10 pr-3 py-2.5 text-sm focus:outline-none focus:border-mwa-burgundy"
        />
      </div>
    </form>

    {/* ---------- Status tabs ---------- */}
    <nav class="px-5 lg:px-0 border-b border-gray-100 flex items-center gap-1 overflow-x-auto mb-4">
      {
        tabs.map((t) => {
          const active = t.key === activeTab;
          return (
            <a
              href={t.href}
              class={`shrink-0 py-3 px-3 text-sm font-semibold relative ${
                active ? "text-mwa-burgundy" : "text-gray-400"
              }`}
            >
              {t.label}
              {active && (
                <span class="absolute bottom-0 left-2 right-2 h-[3px] bg-mwa-burgundy rounded-t-full" />
              )}
            </a>
          );
        })
      }
    </nav>

    <section
      class="px-5 lg:px-0 pb-10 lg:grid lg:grid-cols-2 lg:gap-3 space-y-3 lg:space-y-0"
      data-purpose="payments-list"
    >
      {
        filtered.length === 0 && (
          <div class="text-center py-12 text-gray-400 text-sm col-span-2">
            {q ? `"${q}" гэх захиалга олдсонгүй.` : "Тохирох захиалга алга байна."}
          </div>
        )
      }
      {
        filtered.map((p) => {
          const plan = getPlan(p.plan_id);
          return (
            <article
              class="bg-white border border-gray-100 rounded-2xl shadow-sm p-4"
              data-payment-id={p.id}
            >
              <div class="flex items-start justify-between gap-2 mb-3">
                <div class="min-w-0 flex-1">
                  <div class="text-[11px] text-gray-400 font-mono">
                    {p.reference}
                  </div>
                  <div class="font-bold text-sm leading-tight">
                    {plan?.label ?? p.plan_id}
                  </div>
                </div>
                <span
                  class={`text-[10px] font-bold px-2 py-1 rounded-full whitespace-nowrap ${statusBadge[p.status]}`}
                >
                  {statusLabel[p.status]}
                </span>
              </div>

              {/* User contact block */}
              <div class="bg-gray-50 rounded-xl p-2.5 mb-3 space-y-0.5">
                <div class="text-[10px] text-gray-400 uppercase tracking-wider">
                  Хэрэглэгч
                </div>
                {p.user_name ? (
                  <>
                    <div class="font-bold text-sm leading-tight">{p.user_name}</div>
                    {p.user_email && (
                      <a
                        href={`mailto:${p.user_email}`}
                        class="block text-[11px] text-mwa-burgundy hover:underline truncate"
                      >
                        ✉ {p.user_email}
                      </a>
                    )}
                    {p.user_phone && (
                      <a
                        href={`tel:${p.user_phone}`}
                        class="block text-[11px] text-mwa-burgundy hover:underline"
                      >
                        📞 {p.user_phone}
                      </a>
                    )}
                  </>
                ) : (
                  <div class="text-[11px] text-gray-400 italic">
                    Зочин хэрэглэгч (нэвтрэлгүй)
                  </div>
                )}
              </div>

              <div class="grid grid-cols-2 gap-2 text-xs mb-3">
                <div>
                  <div class="text-gray-400">Дүн</div>
                  <div class="font-bold text-mwa-burgundy">
                    {formatTugrik(p.amount)}
                  </div>
                </div>
                <div>
                  <div class="text-gray-400">Үүсгэсэн</div>
                  <div class="font-semibold">{fmtDateTime(p.created_at)}</div>
                </div>
                <div class="col-span-2">
                  <div class="text-gray-400">Гүйлгээний утга</div>
                  <div class="font-bold">
                    {p.customer_memo ?? (
                      <span class="text-gray-400 font-normal">
                        (хэрэглэгч нэрээ оруулаагүй)
                      </span>
                    )}
                  </div>
                </div>
                {p.status === "confirmed" && p.ends_at && (
                  <div class="col-span-2">
                    <div class="text-gray-400">Хүчинтэй хүртэл</div>
                    <div class="font-semibold">{fmtDate(p.ends_at)}</div>
                  </div>
                )}
                {p.admin_note && (
                  <div class="col-span-2">
                    <div class="text-gray-400">Админ тэмдэглэл</div>
                    <div class="text-[11px] italic">{p.admin_note}</div>
                  </div>
                )}
              </div>

              {p.status === "pending" && (
                <div class="flex gap-2 pt-3 border-t border-gray-100">
                  <button
                    type="button"
                    class="flex-1 bg-emerald-600 text-white text-xs font-bold py-2.5 rounded-xl active:opacity-80 disabled:opacity-50"
                    data-action="confirm"
                    data-id={String(p.id)}
                  >
                    Баталгаажуулах
                  </button>
                  <button
                    type="button"
                    class="flex-1 bg-white border border-rose-300 text-rose-600 text-xs font-bold py-2.5 rounded-xl active:opacity-80 disabled:opacity-50"
                    data-action="reject"
                    data-id={String(p.id)}
                  >
                    Татгалзах
                  </button>
                </div>
              )}
            </article>
          );
        })
      }
    </section>
  </div>
</AdminLayout>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-action]")
    .forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        const action = btn.dataset.action;
        if (!id || !action) return;
        const confirmMsg =
          action === "confirm"
            ? "Энэ төлбөрийг баталгаажуулах уу? Хэрэглэгчийн гишүүнчлэлийн хугацаа эхэлнэ."
            : "Энэ төлбөрийг татгалзах уу?";
        if (!window.confirm(confirmMsg)) return;
        btn.disabled = true;
        try {
          const res = await fetch(`/api/admin/payments/${id}`, {
            method: "POST",
            credentials: "same-origin",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ action }),
          });
          if (res.ok) {
            window.location.reload();
          } else {
            const data = (await res.json().catch(() => ({}))) as {
              error?: string;
            };
            alert(data.error ?? "Алдаа гарлаа");
            btn.disabled = false;
          }
        } catch {
          alert("Сүлжээний алдаа");
          btn.disabled = false;
        }
      });
    });
</script>
