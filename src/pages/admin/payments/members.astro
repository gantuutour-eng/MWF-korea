---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminPaymentsTabs from "../../../components/AdminPaymentsTabs.astro";
import { listActivePaidMembers } from "../../../lib/db";
import { loadAdmin } from "../../../lib/adminAuth";
import { formatTugrik, getPlan } from "../../../lib/membership";

const env = Astro.locals.runtime.env;
const me = await loadAdmin(env.DB, env.SESSIONS, Astro.request.headers.get("cookie"));
if (!me) return Astro.redirect("/profile/login?next=/admin/payments/members");

const q = (Astro.url.searchParams.get("q") ?? "").trim().toLowerCase();
const members = await listActivePaidMembers(env.DB);
const filtered = q
  ? members.filter((m) => {
      return (
        m.name.toLowerCase().includes(q) ||
        m.email.toLowerCase().includes(q) ||
        (m.phone ?? "").toLowerCase().includes(q) ||
        m.reference.toLowerCase().includes(q)
      );
    })
  : members;

function fmtDate(unix: number): string {
  const d = new Date(unix * 1000);
  const pad = (n: number) => String(n).padStart(2, "0");
  return `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())}`;
}

const now = Math.floor(Date.now() / 1000);
function daysRemaining(endsAt: number): number {
  return Math.max(0, Math.floor((endsAt - now) / 86400));
}

function urgencyClass(days: number): string {
  if (days <= 7) return "bg-rose-50 text-rose-700 border-rose-200";
  if (days <= 30) return "bg-amber-50 text-amber-700 border-amber-200";
  return "bg-emerald-50 text-emerald-700 border-emerald-200";
}
---

<AdminLayout title="Идэвхтэй гишүүд" active="payments">
  <header
    class="lg:hidden px-3 pt-6 pb-3 flex items-center bg-white border-b border-gray-100 sticky top-0 z-20"
  >
    <a href="/admin" aria-label="Буцах" class="p-2">
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
      </svg>
    </a>
    <h1 class="flex-1 text-center text-lg font-bold">Идэвхтэй гишүүд</h1>
    <div class="w-10"></div>
  </header>

  <div class="max-w-6xl mx-auto lg:px-8 lg:py-8">
    <div class="hidden lg:flex items-center justify-between mb-6">
      <h1 class="text-2xl font-extrabold">Идэвхтэй гишүүд</h1>
      <button
        type="button"
        class="text-sm text-mwa-burgundy font-bold hover:underline disabled:opacity-50"
        data-export-csv
        disabled={members.length === 0}
      >
        CSV татаж авах →
      </button>
    </div>

    <AdminPaymentsTabs active="members" />

    <form class="px-5 lg:px-0 mb-3" method="get" action="/admin/payments/members">
      <div class="relative">
        <svg
          class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
        </svg>
        <input
          name="q"
          type="search"
          value={q}
          placeholder="Нэр, имэйл, утас, лавлагаагаар хайх"
          class="w-full bg-white border border-gray-200 rounded-xl pl-10 pr-3 py-2.5 text-sm focus:outline-none focus:border-mwa-burgundy"
        />
      </div>
    </form>

    <div class="px-5 lg:px-0 mb-3 text-xs text-gray-500">
      {filtered.length} / {members.length} гишүүн харуулж байна
    </div>

    <section
      class="px-5 lg:px-0 pb-10 space-y-2 lg:space-y-0 lg:grid lg:grid-cols-2 lg:gap-3"
      data-purpose="members-list"
    >
      {
        filtered.length === 0 && (
          <div class="text-center py-12 text-gray-400 text-sm col-span-2">
            {q ? `"${q}" гэх гишүүн олдсонгүй.` : "Одоогоор идэвхтэй гишүүн алга байна."}
          </div>
        )
      }
      {
        filtered.map((m) => {
          const plan = getPlan(m.plan_id);
          const days = daysRemaining(m.ends_at);
          const urgency = urgencyClass(days);
          return (
            <article
              class="bg-white border border-gray-100 rounded-2xl shadow-sm p-4"
              data-user-id={m.user_id}
            >
              <div class="flex items-start gap-3 mb-3">
                <div class="w-12 h-12 rounded-full overflow-hidden bg-mwa-burgundy/10 flex items-center justify-center shrink-0">
                  {m.avatar_url ? (
                    <img src={m.avatar_url} alt="" class="w-full h-full object-cover" />
                  ) : (
                    <span class="text-mwa-burgundy font-extrabold">
                      {m.name.slice(0, 1).toUpperCase()}
                    </span>
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="font-bold text-sm leading-tight truncate">
                    {m.name}
                  </div>
                  <a
                    href={`mailto:${m.email}`}
                    class="block text-[11px] text-mwa-burgundy hover:underline truncate"
                  >
                    ✉ {m.email}
                  </a>
                  {m.phone && (
                    <a
                      href={`tel:${m.phone}`}
                      class="block text-[11px] text-mwa-burgundy hover:underline"
                    >
                      📞 {m.phone}
                    </a>
                  )}
                </div>
                <span
                  class={`text-[10px] font-bold px-2 py-1 rounded-full border whitespace-nowrap ${urgency}`}
                >
                  {days} өдөр
                </span>
              </div>

              <div class="grid grid-cols-2 gap-2 text-xs">
                <div>
                  <div class="text-gray-400">Багц</div>
                  <div class="font-semibold">{plan?.label ?? m.plan_id}</div>
                </div>
                <div>
                  <div class="text-gray-400">Төлсөн дүн</div>
                  <div class="font-semibold">{formatTugrik(m.amount)}</div>
                </div>
                <div>
                  <div class="text-gray-400">Эхэлсэн</div>
                  <div class="font-semibold">{fmtDate(m.starts_at)}</div>
                </div>
                <div>
                  <div class="text-gray-400">Дуусах</div>
                  <div class="font-semibold">{fmtDate(m.ends_at)}</div>
                </div>
                <div class="col-span-2">
                  <div class="text-gray-400">Лавлагаа</div>
                  <div class="font-mono text-[10px] text-gray-500">{m.reference}</div>
                </div>
              </div>
            </article>
          );
        })
      }
    </section>
  </div>
</AdminLayout>

<script
  is:inline
  define:vars={{
    members: members.map((m) => ({
      name: m.name,
      email: m.email,
      phone: m.phone ?? "",
      plan: m.plan_id,
      amount: m.amount,
      reference: m.reference,
      starts_at: m.starts_at,
      ends_at: m.ends_at,
    })),
  }}
>
  const exportBtn = document.querySelector("[data-export-csv]");
  exportBtn?.addEventListener("click", () => {
    if (!members.length) return;
    const fmtDate = (unix) => {
      const d = new Date(unix * 1000);
      const pad = (n) => String(n).padStart(2, "0");
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    };
    const esc = (s) => {
      const v = String(s ?? "");
      return /[",\n]/.test(v) ? `"${v.replace(/"/g, '""')}"` : v;
    };
    const headers = ["Нэр", "Имэйл", "Утас", "Багц", "Дүн", "Лавлагаа", "Эхэлсэн", "Дуусах"];
    const lines = [headers.join(",")];
    for (const m of members) {
      lines.push(
        [m.name, m.email, m.phone, m.plan, m.amount, m.reference, fmtDate(m.starts_at), fmtDate(m.ends_at)]
          .map(esc)
          .join(","),
      );
    }
    const csv = "﻿" + lines.join("\r\n");
    const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `mwa-members-${fmtDate(Math.floor(Date.now() / 1000))}.csv`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  });
</script>
