---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { loadAdmin } from "../../lib/adminAuth";
import {
  listPortfolioPrograms,
  listPortfolioStats,
} from "../../lib/db";
import { toneClasses } from "../../lib/portfolioStyles";

const env = Astro.locals.runtime.env;
const me = await loadAdmin(
  env.DB,
  env.SESSIONS,
  Astro.request.headers.get("cookie"),
);
if (!me) return Astro.redirect("/profile/login?next=/admin/portfolio");

const [programs, stats] = await Promise.all([
  listPortfolioPrograms(env.DB),
  listPortfolioStats(env.DB),
]);

const TONES = ["orange", "purple", "rose", "emerald", "blue", "amber"] as const;
---

<AdminLayout title="Хийгдсэн ажлууд" active="portfolio">
  <header class="lg:hidden px-3 pt-6 pb-3 flex items-center bg-white border-b border-gray-100 sticky top-0 z-20">
    <a href="/admin" aria-label="Буцах" class="p-2">
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M15 19l-7-7 7-7"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
    </a>
    <h1 class="flex-1 text-center text-lg font-bold">Хийгдсэн ажлууд</h1>
    <a
      href="/portfolio"
      class="text-xs text-mwa-burgundy font-bold p-2"
      title="Урьдчилан харах"
    >
      Харах
    </a>
  </header>

  <div class="max-w-6xl mx-auto lg:px-8 lg:py-8">
    <div class="hidden lg:flex items-center justify-between mb-6">
      <h1 class="text-2xl font-extrabold">Хийгдсэн ажлууд</h1>
      <a
        href="/portfolio"
        class="text-sm text-mwa-burgundy font-bold hover:underline"
      >
        Урьдчилан харах →
      </a>
    </div>

    <div class="lg:grid lg:grid-cols-2 lg:gap-6">

  <section class="px-5 lg:px-0 mb-6" data-purpose="programs">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-bold text-base">Гол хөтөлбөрүүд</h2>
      <span class="text-xs text-gray-400">{programs.length} ширхэг</span>
    </div>

    <div class="space-y-2 mb-3" data-sortable="programs">
      {
        programs.length === 0 && (
          <div class="text-center py-6 text-gray-400 text-sm bg-gray-50 rounded-2xl">
            Хоосон байна. Доороос анхны хөтөлбөрөө нэмнэ үү.
          </div>
        )
      }
      {
        programs.map((p) => {
          const tc = toneClasses(p.tone);
          return (
            <article
              class="bg-white border border-gray-100 rounded-2xl p-3 flex items-start gap-2"
              data-program-id={p.id}
              data-sort-item
            >
              <button
                type="button"
                aria-label="Эрэмбэ өөрчлөх"
                class="touch-none shrink-0 self-stretch flex items-center text-gray-300 hover:text-mwa-burgundy active:text-mwa-burgundy cursor-grab active:cursor-grabbing px-0.5"
                data-sort-handle
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                </svg>
              </button>
              <div
                class={`w-10 h-10 rounded-xl flex items-center justify-center text-lg shrink-0 ${tc.icon}`}
              >
                {p.icon}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap mb-0.5">
                  <h3 class="font-bold text-sm">{p.title}</h3>
                  {p.since_label && (
                    <span class="text-[10px] text-gray-400">· {p.since_label}</span>
                  )}
                </div>
                <p class="text-xs text-mwa-text-secondary leading-relaxed line-clamp-2">
                  {p.description}
                </p>
              </div>
            </article>
          );
        })
      }
    </div>

    <details class="bg-mwa-burgundy/5 border border-mwa-burgundy/20 rounded-2xl">
      <summary
        class="cursor-pointer px-4 py-3 text-sm font-bold text-mwa-burgundy flex items-center gap-2 select-none"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"/>
        </svg>
        Хөтөлбөр нэмэх
      </summary>
      <form
        class="px-4 pb-4 space-y-3"
        onsubmit="return false"
        data-form="program"
      >
        <div class="grid grid-cols-[auto_1fr] gap-2">
          <input
            name="icon"
            type="text"
            value="✨"
            maxlength="4"
            placeholder="✨"
            class="w-14 text-center bg-white border border-gray-200 rounded-xl px-2 py-3 text-lg focus:outline-none focus:border-mwa-burgundy"
          />
          <input
            name="title"
            type="text"
            required
            placeholder="Хөтөлбөрийн нэр"
            class="bg-white border border-gray-200 rounded-xl px-3 py-3 text-sm focus:outline-none focus:border-mwa-burgundy"
          />
        </div>
        <textarea
          name="description"
          required
          rows="3"
          placeholder="Хөтөлбөрийн тайлбар"
          class="w-full bg-white border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-mwa-burgundy resize-y"
        ></textarea>
        <div class="grid grid-cols-2 gap-2">
          <input
            name="since_label"
            type="text"
            placeholder="2024 оноос (заавал биш)"
            class="bg-white border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-mwa-burgundy"
          />
          <input
            name="sort_order"
            type="number"
            value="100"
            min="0"
            placeholder="Эрэмбэ"
            class="bg-white border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-mwa-burgundy"
          />
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs text-mwa-text-secondary">Өнгө:</span>
          {
            TONES.map((t, i) => (
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name="tone"
                  value={t}
                  checked={i === 1}
                  class="peer hidden"
                />
                <span
                  class={`block w-6 h-6 rounded-full bg-${t}-500 border-2 border-transparent peer-checked:border-mwa-text-primary peer-checked:scale-110 transition-transform`}
                  style={`background-color: var(--tw-${t})`}
                >
                  <span class={`block w-full h-full rounded-full ${toneClasses(t).icon.split(" ")[0]}`} />
                </span>
              </label>
            ))
          }
        </div>
        <button
          type="submit"
          class="w-full bg-mwa-burgundy text-white font-bold py-3 rounded-xl text-sm active:opacity-80"
        >
          Хөтөлбөр нэмэх
        </button>
        <p data-error class="text-xs text-rose-500 text-center hidden"></p>
      </form>
    </details>
  </section>

  <section class="px-5 lg:px-0 mb-10" data-purpose="stats">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-bold text-base">Статистик</h2>
      <span class="text-xs text-gray-400">{stats.length} ширхэг</span>
    </div>

    <div class="grid grid-cols-2 gap-2 mb-3" data-sortable="stats">
      {
        stats.length === 0 && (
          <div class="col-span-2 text-center py-6 text-gray-400 text-sm bg-gray-50 rounded-2xl">
            Статистик хоосон.
          </div>
        )
      }
      {
        stats.map((s) => {
          const tc = toneClasses(s.tone);
          return (
            <div
              class={`relative rounded-xl p-3 text-center ${tc.stat}`}
              data-stat-id={s.id}
              data-sort-item
            >
              <button
                type="button"
                aria-label="Эрэмбэ өөрчлөх"
                class="absolute top-1.5 right-1.5 touch-none w-6 h-6 rounded-md bg-white/60 hover:bg-white text-gray-500 flex items-center justify-center cursor-grab active:cursor-grabbing"
                data-sort-handle
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                </svg>
              </button>
              <div class="text-xl font-extrabold">{s.value}</div>
              <div class="text-[10px] text-mwa-text-secondary mt-0.5">
                {s.label}
              </div>
            </div>
          );
        })
      }
    </div>

    <details class="bg-mwa-burgundy/5 border border-mwa-burgundy/20 rounded-2xl">
      <summary
        class="cursor-pointer px-4 py-3 text-sm font-bold text-mwa-burgundy flex items-center gap-2 select-none"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M12 4v16m8-8H4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"/>
        </svg>
        Статистик нэмэх
      </summary>
      <form
        class="px-4 pb-4 space-y-3"
        onsubmit="return false"
        data-form="stat"
      >
        <div class="grid grid-cols-2 gap-2">
          <input
            name="value"
            type="text"
            required
            placeholder="1,500+"
            class="bg-white border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-mwa-burgundy"
          />
          <input
            name="label"
            type="text"
            required
            placeholder="Гишүүн"
            class="bg-white border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-mwa-burgundy"
          />
        </div>
        <div class="grid grid-cols-2 gap-2">
          <select
            name="tone"
            class="bg-white border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-mwa-burgundy"
          >
            {TONES.map((t) => <option value={t}>{t}</option>)}
          </select>
          <input
            name="sort_order"
            type="number"
            value="100"
            min="0"
            placeholder="Эрэмбэ"
            class="bg-white border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-mwa-burgundy"
          />
        </div>
        <button
          type="submit"
          class="w-full bg-mwa-burgundy text-white font-bold py-3 rounded-xl text-sm active:opacity-80"
        >
          Статистик нэмэх
        </button>
        <p data-error class="text-xs text-rose-500 text-center hidden"></p>
      </form>
    </details>
  </section>
    </div>
  </div>
</AdminLayout>

<script>
  import Sortable from "sortablejs";

  interface ApiResponse {
    ok?: boolean;
    id?: number;
    error?: string;
  }

  const endpoints: Record<string, string> = {
    program: "/api/portfolio/programs",
    stat: "/api/portfolio/stats",
  };

  // ---------- Drag-and-drop reordering ----------
  const reorderToast = document.createElement("div");
  reorderToast.className =
    "fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 bg-mwa-text-primary text-white text-xs font-semibold rounded-full shadow-lg opacity-0 pointer-events-none transition-opacity duration-200";
  reorderToast.setAttribute("role", "status");
  reorderToast.setAttribute("aria-live", "polite");
  document.body.appendChild(reorderToast);
  let reorderToastTimer: number | null = null;
  function showReorderToast(text: string) {
    reorderToast.textContent = text;
    reorderToast.classList.remove("opacity-0");
    reorderToast.classList.add("opacity-100");
    if (reorderToastTimer) window.clearTimeout(reorderToastTimer);
    reorderToastTimer = window.setTimeout(() => {
      reorderToast.classList.remove("opacity-100");
      reorderToast.classList.add("opacity-0");
    }, 1800);
  }

  function wireSortable(kind: "programs" | "stats", idAttr: string) {
    const root = document.querySelector<HTMLElement>(
      `[data-sortable="${kind}"]`,
    );
    if (!root || root.children.length <= 1) return;
    Sortable.create(root, {
      handle: "[data-sort-handle]",
      animation: 180,
      ghostClass: "opacity-40",
      onEnd: async () => {
        const ids = Array.from(
          root.querySelectorAll<HTMLElement>("[data-sort-item]"),
        )
          .map((el) => Number(el.getAttribute(idAttr)))
          .filter((n) => Number.isFinite(n));
        if (ids.length === 0) return;
        try {
          const res = await fetch(`/api/portfolio/${kind}/reorder`, {
            method: "POST",
            credentials: "same-origin",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ ids }),
          });
          if (res.ok) showReorderToast("Эрэмбэ хадгалагдлаа");
          else {
            const data = (await res.json().catch(() => ({}))) as {
              error?: string;
            };
            showReorderToast(data.error ?? "Алдаа гарлаа");
          }
        } catch {
          showReorderToast("Сүлжээний алдаа");
        }
      },
    });
  }

  wireSortable("programs", "data-program-id");
  wireSortable("stats", "data-stat-id");

  document.querySelectorAll<HTMLFormElement>("[data-form]").forEach((form) => {
    const kind = form.dataset.form ?? "";
    const url = endpoints[kind];
    if (!url) return;
    const errorEl = form.querySelector<HTMLElement>("[data-error]");
    const submitBtn = form.querySelector<HTMLButtonElement>("button[type='submit']");

    form.addEventListener("submit", async () => {
      if (!errorEl || !submitBtn) return;
      errorEl.classList.add("hidden");
      submitBtn.disabled = true;

      const data = new FormData(form);
      const payload: Record<string, unknown> = {};
      for (const [k, v] of data.entries()) {
        if (typeof v !== "string") continue;
        const trimmed = v.trim();
        if (trimmed === "") continue;
        if (k === "sort_order") payload[k] = Number(trimmed);
        else payload[k] = trimmed;
      }

      try {
        const res = await fetch(url, {
          method: "POST",
          credentials: "same-origin",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        const body = (await res.json().catch(() => ({}))) as ApiResponse;
        if (res.ok && body.ok) {
          window.location.reload();
        } else {
          errorEl.textContent = body.error ?? "Алдаа гарлаа";
          errorEl.classList.remove("hidden");
          submitBtn.disabled = false;
        }
      } catch {
        errorEl.textContent = "Сүлжээний алдаа";
        errorEl.classList.remove("hidden");
        submitBtn.disabled = false;
      }
    });
  });
</script>
