---
import AppLayout from "../../../layouts/AppLayout.astro";
import ChatThread from "../../../components/ChatThread.astro";
import {
  listChatMessages,
  markChatRead,
  getUserById,
} from "../../../lib/db";
import { loadAdmin } from "../../../lib/adminAuth";

const env = Astro.locals.runtime.env;
const me = await loadAdmin(
  env.DB,
  env.SESSIONS,
  Astro.request.headers.get("cookie"),
);
if (!me) return Astro.redirect(`/profile/login?next=/admin/chat/${Astro.params.user_id}`);

const targetId = Number(Astro.params.user_id);
if (!Number.isFinite(targetId)) {
  return Astro.redirect("/admin/chat");
}

const target = await getUserById(env.DB, targetId);
if (!target || target.role === "admin") {
  return Astro.redirect("/admin/chat");
}

const messages = await listChatMessages(env.DB, targetId);
await markChatRead(env.DB, targetId, "admin");
---

<AppLayout
  title={`${target.name} — чат`}
  activeTab="chat"
  showHeader={false}
  showBottomNav={false}
>
  <ChatThread
    initialMessages={messages}
    viewerId={me.id}
    viewerRole="admin"
    conversationUserId={target.id}
    partnerName={target.name}
    backHref="/admin/chat"
  />
</AppLayout>
