---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { loadAdmin } from "../../../lib/adminAuth";

const env = Astro.locals.runtime.env;
const me = await loadAdmin(
  env.DB,
  env.SESSIONS,
  Astro.request.headers.get("cookie"),
);
if (!me) return Astro.redirect("/profile/login?next=/admin/news/new");
---

<AdminLayout title="Шинэ мэдээ нэмэх" active="news">
  <header class="lg:hidden px-3 pt-6 pb-3 flex items-center bg-white border-b border-gray-100 sticky top-0 z-20">
    <a href="/admin" aria-label="Буцах" class="p-2">
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M15 19l-7-7 7-7"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
    </a>
    <h1 class="flex-1 text-center text-lg font-bold">Шинэ мэдээ нэмэх</h1>
    <div class="w-10"></div>
  </header>

  <div class="max-w-2xl mx-auto lg:px-8 lg:py-8">
    <div class="hidden lg:flex items-center gap-3 mb-6">
      <a href="/admin" class="text-sm text-mwa-burgundy font-bold">← Буцах</a>
      <h1 class="text-2xl font-extrabold">Шинэ мэдээ нэмэх</h1>
    </div>

    <form
      id="news-form"
      class="px-5 lg:px-0 pb-10 space-y-4"
      onsubmit="return false"
      enctype="multipart/form-data"
    >
      <div>
        <label class="text-xs font-bold text-mwa-text-secondary mb-1.5 block">
          Гарчиг <span class="text-rose-500">*</span>
        </label>
        <input
          name="title"
          type="text"
          required
          maxlength="200"
          placeholder="Жнь: Шинэ хөтөлбөр эхэллээ"
          class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-mwa-burgundy"
        />
      </div>

      <div>
        <label class="text-xs font-bold text-mwa-text-secondary mb-1.5 block">
          Дэд гарчиг
        </label>
        <input
          name="subtitle"
          type="text"
          maxlength="300"
          placeholder="Зургийн доор гарах нэг мөрийн тайлбар"
          class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-mwa-burgundy"
        />
      </div>

      <div>
        <label class="text-xs font-bold text-mwa-text-secondary mb-1.5 block">
          Ангилал <span class="text-rose-500">*</span>
        </label>
        <div class="flex gap-2">
          <label class="flex-1">
            <input
              type="radio"
              name="category"
              value="notice"
              checked
              class="peer hidden"
            />
            <div class="text-center text-sm font-semibold py-3 rounded-xl border border-gray-200 peer-checked:bg-mwa-burgundy peer-checked:text-white peer-checked:border-mwa-burgundy cursor-pointer">
              Мэдэгдэл
            </div>
          </label>
          <label class="flex-1">
            <input
              type="radio"
              name="category"
              value="article"
              class="peer hidden"
            />
            <div class="text-center text-sm font-semibold py-3 rounded-xl border border-gray-200 peer-checked:bg-mwa-burgundy peer-checked:text-white peer-checked:border-mwa-burgundy cursor-pointer">
              Нийтлэл
            </div>
          </label>
        </div>
      </div>

      <div>
        <label class="text-xs font-bold text-mwa-text-secondary mb-1.5 block">
          Зургууд <span class="text-gray-400 font-normal">(нэг буюу олон сонгож болно)</span>
        </label>

        <label
          id="picker-label"
          class="block cursor-pointer bg-mwa-burgundy/5 border-2 border-dashed border-mwa-burgundy/40 rounded-xl py-6 px-4 text-center hover:bg-mwa-burgundy/10 transition"
        >
          <svg
            class="w-7 h-7 mx-auto text-mwa-burgundy mb-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2 1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"></path>
          </svg>
          <span class="text-sm font-bold text-mwa-burgundy block">
            Зураг сонгох
          </span>
          <span class="text-[11px] text-gray-500 block mt-0.5">
            PNG, JPG, WEBP, GIF, SVG · 5MB-ээс ихгүй · хамгийн ихдээ 10 ширхэг
          </span>
          <input
            id="picker-input"
            type="file"
            accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml"
            multiple
            class="hidden"
          />
        </label>

        <ul
          id="preview-list"
          class="mt-3 grid grid-cols-3 gap-2"
          aria-label="Сонгосон зургууд"
        ></ul>
        <p class="text-[11px] text-gray-400 mt-1.5" id="preview-hint" hidden>
          Эхний зураг үндсэн зураг болж жагсаалт болон Нүүр хуудсанд харагдана.
        </p>
      </div>

      <div>
        <label class="text-xs font-bold text-mwa-text-secondary mb-1.5 block">
          Агуулга <span class="text-rose-500">*</span>
        </label>
        <textarea
          name="body"
          required
          rows="10"
          placeholder="Мэдээний дэлгэрэнгүй агуулга. Хоосон мөрөөр догол мөр тусгаарлаж, ☆ 📌 💬 зэрэг тэмдэгт ашиглаж болно."
          class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm leading-relaxed focus:outline-none focus:border-mwa-burgundy resize-y"
        ></textarea>
      </div>

      <p
        id="news-error"
        class="text-sm text-rose-500 text-center hidden"
      >
      </p>
      <p
        id="news-success"
        class="text-sm text-emerald-600 text-center hidden"
      >
      </p>

      <div class="flex gap-2 pt-2">
        <a
          href="/admin"
          class="flex-1 text-center bg-white border border-gray-200 text-mwa-text-primary font-bold rounded-xl py-3 text-sm active:bg-gray-50"
        >
          Цуцлах
        </a>
        <button
          type="submit"
          class="flex-1 bg-mwa-burgundy text-white font-bold rounded-xl py-3 text-sm active:opacity-80 disabled:opacity-50"
        >
          Нийтлэх
        </button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  import { convertImageToWebp } from "../../../scripts/imageToWebp";

  interface ApiResponse {
    ok?: boolean;
    id?: number;
    error?: string;
  }

  const MAX_FILES = 10;
  const MAX_BYTES = 5 * 1024 * 1024;
  const ALLOWED = [
    "image/png",
    "image/jpeg",
    "image/webp",
    "image/gif",
    "image/svg+xml",
  ];

  const form = document.getElementById("news-form") as HTMLFormElement | null;
  const errorEl = document.getElementById("news-error");
  const successEl = document.getElementById("news-success");
  const picker = document.getElementById("picker-input") as HTMLInputElement | null;
  const previewList = document.getElementById("preview-list") as HTMLUListElement | null;
  const previewHint = document.getElementById("preview-hint") as HTMLParagraphElement | null;

  // Track selected files in an array so user can add/remove without losing earlier picks.
  const selected: { file: File; url: string }[] = [];

  function showError(msg: string) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.classList.remove("hidden");
  }

  function clearMessages() {
    errorEl?.classList.add("hidden");
    successEl?.classList.add("hidden");
  }

  function renderPreviews() {
    if (!previewList || !previewHint) return;
    previewList.innerHTML = "";
    if (selected.length === 0) {
      previewHint.hidden = true;
      return;
    }
    previewHint.hidden = false;
    selected.forEach((item, idx) => {
      const li = document.createElement("li");
      li.className = "relative aspect-square rounded-xl overflow-hidden bg-gray-100 border border-gray-200 group";

      const img = document.createElement("img");
      img.src = item.url;
      img.alt = "";
      img.className = "w-full h-full object-cover";
      li.appendChild(img);

      if (idx === 0) {
        const badge = document.createElement("span");
        badge.className = "absolute top-1.5 left-1.5 text-[10px] font-bold bg-mwa-burgundy text-white px-1.5 py-0.5 rounded";
        badge.textContent = "Үндсэн";
        li.appendChild(badge);
      }

      const remove = document.createElement("button");
      remove.type = "button";
      remove.setAttribute("aria-label", "Устгах");
      remove.className = "absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-black/60 text-white text-xs leading-none flex items-center justify-center";
      remove.textContent = "×";
      remove.addEventListener("click", () => {
        URL.revokeObjectURL(item.url);
        selected.splice(idx, 1);
        renderPreviews();
      });
      li.appendChild(remove);

      previewList.appendChild(li);
    });
  }

  picker?.addEventListener("change", () => {
    clearMessages();
    const files = picker.files ? Array.from(picker.files) : [];
    for (const file of files) {
      if (!ALLOWED.includes(file.type)) {
        showError(`"${file.name}" зураг биш байна`);
        continue;
      }
      if (file.size > MAX_BYTES) {
        showError(`"${file.name}" 5MB-ээс хэтэрсэн`);
        continue;
      }
      if (selected.length >= MAX_FILES) {
        showError(`Хамгийн ихдээ ${MAX_FILES} зураг`);
        break;
      }
      selected.push({ file, url: URL.createObjectURL(file) });
    }
    // Reset the input so picking the same file again still fires a change.
    picker.value = "";
    renderPreviews();
  });

  form?.addEventListener("submit", async () => {
    if (!form) return;
    clearMessages();

    const submitBtn = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    if (submitBtn) submitBtn.disabled = true;

    const fd = new FormData();
    const data = new FormData(form);
    fd.set("title", String(data.get("title") ?? "").trim());
    fd.set("subtitle", String(data.get("subtitle") ?? "").trim());
    fd.set("body", String(data.get("body") ?? "").trim());
    fd.set("category", String(data.get("category") ?? "notice"));
    // Convert each selected file to WebP before upload (PNG/JPEG only;
    // SVG/GIF/already-WebP pass through unchanged).
    for (const item of selected) {
      try {
        const converted = await convertImageToWebp(item.file);
        fd.append("images", converted, converted.name);
      } catch {
        fd.append("images", item.file, item.file.name);
      }
    }

    try {
      const res = await fetch("/api/news", {
        method: "POST",
        credentials: "same-origin",
        body: fd,
      });
      const body = (await res.json().catch(() => ({}))) as ApiResponse;
      if (res.ok && body.ok && body.id !== undefined) {
        if (successEl) {
          successEl.textContent = `Амжилттай нийтэллээ (id: ${body.id})`;
          successEl.classList.remove("hidden");
        }
        window.setTimeout(() => {
          window.location.href = `/news/${body.id}`;
        }, 800);
      } else {
        showError(body.error ?? "Алдаа гарлаа");
        if (submitBtn) submitBtn.disabled = false;
      }
    } catch {
      showError("Сүлжээний алдаа");
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
