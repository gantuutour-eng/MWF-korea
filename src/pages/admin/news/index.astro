---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { loadAdmin } from "../../../lib/adminAuth";
import { listNews } from "../../../lib/db";
import { formatDate as fmtDate } from "../../../lib/datetime";

const env = Astro.locals.runtime.env;
const me = await loadAdmin(env.DB, env.SESSIONS, Astro.request.headers.get("cookie"));
if (!me) return Astro.redirect("/profile/login?next=/admin/news");

const rows = await listNews(env.DB, { limit: 200 });

const HOME_LIMIT = 6;
---

<AdminLayout title="Мэдээ" active="news">
  <header class="lg:hidden px-3 pt-6 pb-3 flex items-center bg-white border-b border-gray-100 sticky top-0 z-20">
    <a href="/admin" aria-label="Буцах" class="p-2">
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M15 19l-7-7 7-7"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
    </a>
    <h1 class="flex-1 text-center text-lg font-bold">Мэдээ</h1>
    <a
      href="/admin/news/new"
      class="text-xs font-bold text-mwa-burgundy p-2"
    >
      + Нэмэх
    </a>
  </header>

  <div class="max-w-6xl mx-auto lg:px-8 lg:py-8">
    <div class="hidden lg:flex items-center justify-between mb-6">
      <h1 class="text-2xl font-extrabold">Мэдээ</h1>
      <a
        href="/admin/news/new"
        class="bg-mwa-burgundy text-white text-sm font-bold rounded-lg px-4 py-2.5 active:opacity-80 hover:opacity-90"
      >
        + Шинэ мэдээ нэмэх
      </a>
    </div>

    {rows.length > 1 && (
      <div class="mx-5 lg:mx-0 mt-2 p-3 bg-mwa-burgundy/5 border border-mwa-burgundy/20 rounded-xl flex items-start gap-2">
        <svg class="w-4 h-4 text-mwa-burgundy mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M4 8h16M4 12h10M4 16h16" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
        </svg>
        <div class="text-[11px] text-mwa-text-secondary leading-snug">
          Эрэмбийг өөрчлөхдөө карточкын зүүн дээд буланд байгаа <strong>≡</strong> тэмдэгээс барьж зөөнө.
          Эхний <strong>{HOME_LIMIT}</strong> карточка нь нүүр хуудсанд харагдана.
        </div>
      </div>
    )}

    <section
      class="px-5 lg:px-0 pt-4 pb-10 space-y-2 lg:space-y-0 lg:grid lg:grid-cols-2 lg:gap-3"
      data-purpose="news-list"
      data-sortable
    >
      {
        rows.length === 0 && (
          <div class="text-center py-12 text-gray-400 text-sm col-span-2">
            Одоогоор мэдээ алга байна.
            <div class="mt-3">
              <a
                href="/admin/news/new"
                class="inline-block bg-mwa-burgundy text-white text-xs font-bold rounded-lg px-4 py-2 active:opacity-80"
              >
                + Шинэ мэдээ нэмэх
              </a>
            </div>
          </div>
        )
      }

      {
        rows.map((row, i) => (
          <article
            class="relative bg-white border border-gray-100 rounded-2xl shadow-sm overflow-hidden"
            data-news-id={row.id}
            data-sort-item
          >
            {i < HOME_LIMIT && (
              <span class="absolute top-2 right-2 z-10 text-[10px] font-bold bg-mwa-burgundy text-white px-1.5 py-0.5 rounded">
                Нүүр #{i + 1}
              </span>
            )}
            <div class="flex gap-3 p-3">
              <button
                type="button"
                aria-label="Эрэмбэ өөрчлөх"
                class="touch-none shrink-0 self-stretch flex items-center justify-center w-7 -mx-1 text-gray-300 hover:text-mwa-burgundy active:text-mwa-burgundy cursor-grab active:cursor-grabbing"
                data-sort-handle
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                </svg>
              </button>
              <div class="w-20 h-20 shrink-0 rounded-xl overflow-hidden bg-gray-100">
                {row.cover_url ? (
                  <img
                    src={row.cover_url}
                    alt=""
                    loading="lazy"
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <div class="w-full h-full bg-mwa-burgundy/10" />
                )}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5 mb-1 flex-wrap">
                  <span
                    class={`inline-block text-[10px] font-bold px-1.5 py-0.5 rounded ${
                      row.category === "notice"
                        ? "bg-amber-100 text-amber-700"
                        : "bg-blue-100 text-blue-700"
                    }`}
                  >
                    {row.category === "notice" ? "Мэдэгдэл" : "Нийтлэл"}
                  </span>
                  <span class="text-[11px] text-gray-400">
                    {fmtDate(row.published_at)}
                  </span>
                </div>
                <h3 class="font-bold text-sm leading-tight line-clamp-2">
                  {row.title}
                </h3>
                {row.subtitle && (
                  <p class="text-[11px] text-gray-500 mt-1 line-clamp-1">
                    {row.subtitle}
                  </p>
                )}
              </div>
            </div>
            <div class="flex gap-2 px-3 pb-3 pt-1 border-t border-gray-100">
              <a
                href={`/news/${row.id}`}
                class="flex-1 text-center bg-white border border-gray-200 text-gray-600 text-xs font-bold py-2 rounded-lg active:bg-gray-50"
              >
                Харах
              </a>
              <a
                href={`/admin/news/edit/${row.id}`}
                class="flex-1 text-center bg-white border border-mwa-burgundy text-mwa-burgundy text-xs font-bold py-2 rounded-lg active:opacity-80"
              >
                Засах
              </a>
              <button
                type="button"
                class="flex-1 bg-white border border-rose-300 text-rose-600 text-xs font-bold py-2 rounded-lg active:opacity-80 disabled:opacity-50"
                data-action="delete"
                data-id={String(row.id)}
                data-title={row.title}
              >
                Устгах
              </button>
            </div>
          </article>
        ))
      }
    </section>

    <div
      id="reorder-toast"
      class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 bg-mwa-text-primary text-white text-xs font-semibold rounded-full shadow-lg opacity-0 pointer-events-none transition-opacity duration-200"
      role="status"
      aria-live="polite"
    >
    </div>
  </div>
</AdminLayout>

<script>
  import Sortable from "sortablejs";

  // ---------- Delete ----------
  document
    .querySelectorAll<HTMLButtonElement>('[data-action="delete"]')
    .forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        const title = btn.dataset.title ?? "";
        if (!id) return;
        if (!window.confirm(`"${title}" мэдээг устгах уу?`)) return;
        btn.disabled = true;
        try {
          const res = await fetch(`/api/news/${id}`, {
            method: "DELETE",
            credentials: "same-origin",
          });
          if (res.ok) {
            window.location.reload();
          } else {
            const data = (await res.json().catch(() => ({}))) as {
              error?: string;
            };
            alert(data.error ?? "Алдаа гарлаа");
            btn.disabled = false;
          }
        } catch {
          alert("Сүлжээний алдаа");
          btn.disabled = false;
        }
      });
    });

  // ---------- Sortable drag-and-drop ----------
  const HOME_LIMIT = 6;
  const list = document.querySelector<HTMLElement>("[data-sortable]");
  const toast = document.getElementById("reorder-toast");

  let toastTimer: number | null = null;
  function showToast(text: string) {
    if (!toast) return;
    toast.textContent = text;
    toast.classList.remove("opacity-0");
    toast.classList.add("opacity-100");
    if (toastTimer) window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.classList.remove("opacity-100");
      toast.classList.add("opacity-0");
    }, 1800);
  }

  function readIds(): number[] {
    if (!list) return [];
    return Array.from(list.querySelectorAll<HTMLElement>("[data-sort-item]"))
      .map((el) => Number(el.dataset.newsId))
      .filter((n) => Number.isFinite(n));
  }

  function refreshHomeBadges() {
    if (!list) return;
    const items = list.querySelectorAll<HTMLElement>("[data-sort-item]");
    items.forEach((item, idx) => {
      const existing = item.querySelector<HTMLElement>("[data-home-badge]");
      if (idx < HOME_LIMIT) {
        if (existing) {
          existing.textContent = `Нүүр #${idx + 1}`;
        } else {
          const badge = document.createElement("span");
          badge.dataset.homeBadge = "";
          badge.className = "absolute top-2 right-2 z-10 text-[10px] font-bold bg-mwa-burgundy text-white px-1.5 py-0.5 rounded";
          badge.textContent = `Нүүр #${idx + 1}`;
          item.appendChild(badge);
        }
      } else if (existing) {
        existing.remove();
      }
    });
  }

  // Tag the SSR-rendered badges so refreshHomeBadges() can find them.
  list?.querySelectorAll<HTMLElement>("[data-sort-item] > span").forEach((s) => {
    if (s.textContent?.startsWith("Нүүр #")) s.dataset.homeBadge = "";
  });

  async function save() {
    const ids = readIds();
    if (ids.length === 0) return;
    try {
      const res = await fetch("/api/news/reorder", {
        method: "POST",
        credentials: "same-origin",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ ids }),
      });
      if (res.ok) {
        showToast("Эрэмбэ хадгалагдлаа");
      } else {
        const data = (await res.json().catch(() => ({}))) as { error?: string };
        showToast(data.error ?? "Алдаа гарлаа");
      }
    } catch {
      showToast("Сүлжээний алдаа");
    }
  }

  if (list && list.children.length > 1) {
    Sortable.create(list, {
      handle: "[data-sort-handle]",
      animation: 180,
      ghostClass: "opacity-40",
      chosenClass: "ring-2",
      dragClass: "shadow-2xl",
      onEnd: () => {
        refreshHomeBadges();
        save();
      },
    });
  }
</script>
