---
import AppLayout from "../../layouts/AppLayout.astro";

const next = Astro.url.searchParams.get("next") ?? "";
const googleHref = next
  ? `/api/auth/google?next=${encodeURIComponent(next)}`
  : "/api/auth/google";
---

<AppLayout
  title="Бүртгүүлэх"
  activeTab="profile"
  showHeader={false}
  showBottomNav={false}
>
  <div class="px-6 pt-10 pb-10 flex flex-col items-center">
    <img
      src="/images/logo.png"
      alt="MWA"
      class="w-32 h-32 object-contain mb-5"
    />
    <h1 class="text-mwa-burgundy text-2xl font-extrabold text-center mb-2">
      Бүртгүүлэх
    </h1>
    <p class="text-sm text-mwa-text-secondary text-center mb-8">
      Гишүүнчлэлд элсэхийн тулд мэдээллээ оруулна уу
    </p>

    <form
      id="register-form"
      class="w-full space-y-3"
      onsubmit="return false"
      data-next={next}
    >
      <label
        class="flex items-center gap-3 bg-white border border-gray-200 rounded-2xl px-4 py-3.5 focus-within:border-mwa-burgundy"
      >
        <svg
          class="w-5 h-5 text-gray-400 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <input
          name="name"
          type="text"
          placeholder="Овог нэр"
          required
          class="flex-1 bg-transparent text-base focus:outline-none placeholder:text-gray-400"
        />
      </label>

      <label
        class="flex items-center gap-3 bg-white border border-gray-200 rounded-2xl px-4 py-3.5 focus-within:border-mwa-burgundy"
      >
        <svg
          class="w-5 h-5 text-gray-400 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <input
          name="email"
          type="email"
          placeholder="Имэйл"
          required
          autocomplete="email"
          class="flex-1 bg-transparent text-base focus:outline-none placeholder:text-gray-400"
        />
      </label>

      <label
        class="flex items-center gap-3 bg-white border border-gray-200 rounded-2xl px-4 py-3.5 focus-within:border-mwa-burgundy"
      >
        <svg
          class="w-5 h-5 text-gray-400 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M3 5a2 2 0 012-2h2.5a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.252 1.018l-2.1 2.1a16 16 0 006.31 6.31l2.1-2.1a1 1 0 011.017-.252l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.611 21 3 14.389 3 6V5z"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <input
          name="phone"
          type="tel"
          placeholder="Утас (заавал биш)"
          class="flex-1 bg-transparent text-base focus:outline-none placeholder:text-gray-400"
        />
      </label>

      <label
        class="flex items-center gap-3 bg-white border border-gray-200 rounded-2xl px-4 py-3.5 focus-within:border-mwa-burgundy"
      >
        <svg
          class="w-5 h-5 text-gray-400 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M8 11V7a4 4 0 118 0v4M5 11h14a2 2 0 012 2v7a2 2 0 01-2 2H5a2 2 0 01-2-2v-7a2 2 0 012-2z"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <input
          name="password"
          type="password"
          placeholder="Нууц үг (8+ тэмдэгт)"
          required
          autocomplete="new-password"
          minlength="8"
          class="flex-1 bg-transparent text-base focus:outline-none placeholder:text-gray-400"
          data-password
        />
        <button
          type="button"
          aria-label="Нууц үг харах"
          class="p-1 text-gray-400"
          data-toggle-password
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            data-eye-open
          >
            <path
              d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <circle cx="12" cy="12" r="3" stroke-width="2" />
          </svg>
          <svg
            class="w-5 h-5 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            data-eye-closed
          >
            <path
              d="M17.94 17.94A10.94 10.94 0 0112 19c-7 0-11-7-11-7a19.78 19.78 0 014.22-5.42M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 7 11 7a19.86 19.86 0 01-3.16 4.19M1 1l22 22M14.12 14.12A3 3 0 119.88 9.88"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </label>

      <p
        id="register-error"
        class="text-sm text-rose-500 text-center pt-1 hidden"
      >
      </p>

      <button
        type="submit"
        class="w-full bg-mwa-burgundy text-white font-bold py-4 rounded-2xl text-base mt-3 active:opacity-80"
      >
        Бүртгүүлэх
      </button>
    </form>

    <div class="flex items-center gap-2 mt-6 text-sm">
      <span class="text-mwa-text-secondary">Бүртгэлтэй юу?</span>
      <a
        href={next ? `/profile/login?next=${encodeURIComponent(next)}` : "/profile/login"}
        class="text-mwa-burgundy font-semibold"
      >
        Нэвтрэх
      </a>
    </div>

    <div class="w-full flex items-center gap-3 my-8">
      <span class="flex-1 h-px bg-gray-200"></span>
      <span class="text-[11px] text-gray-400 uppercase tracking-wide">
        эсвэл
      </span>
      <span class="flex-1 h-px bg-gray-200"></span>
    </div>

    <div class="flex flex-col items-center gap-2">
      <a
        href={googleHref}
        aria-label="Google-ээр бүртгүүлэх"
        class="w-14 h-14 rounded-full bg-white border border-gray-200 shadow-sm flex items-center justify-center active:opacity-80"
      >
        <svg class="w-7 h-7" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <path
            fill="#FFC107"
            d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.2-.1-2.4-.4-3.5z"
          />
          <path
            fill="#FF3D00"
            d="M6.3 14.7l6.6 4.8C14.6 16 19 13 24 13c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.6 8.5 6.3 14.7z"
          />
          <path
            fill="#4CAF50"
            d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2c-2 1.5-4.5 2.4-7.2 2.4-5.2 0-9.6-3.3-11.2-7.9l-6.5 5C9.5 39.5 16.2 44 24 44z"
          />
          <path
            fill="#1976D2"
            d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.3 5.6l6.2 5.2C40.7 36.7 44 30.9 44 24c0-1.2-.1-2.4-.4-3.5z"
          />
        </svg>
      </a>
      <p class="text-xs text-mwa-text-secondary text-center">
        GOOGLE ID-аар хялбархан нэвтрээрэй
      </p>
    </div>
  </div>
</AppLayout>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-toggle-password]")
    .forEach((btn) => {
      const open = btn.querySelector<SVGElement>("[data-eye-open]");
      const closed = btn.querySelector<SVGElement>("[data-eye-closed]");
      const input = btn
        .closest("label")
        ?.querySelector<HTMLInputElement>("[data-password]");
      if (!input || !open || !closed) return;
      btn.addEventListener("click", () => {
        const showing = input.type === "text";
        input.type = showing ? "password" : "text";
        open.classList.toggle("hidden", !showing);
        closed.classList.toggle("hidden", showing);
      });
    });

  const form = document.getElementById(
    "register-form",
  ) as HTMLFormElement | null;
  const errorEl = document.getElementById("register-error");
  form?.addEventListener("submit", async () => {
    if (!form || !errorEl) return;
    errorEl.classList.add("hidden");
    const data = new FormData(form);
    const res = await fetch("/api/auth/register", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        name: data.get("name"),
        email: data.get("email"),
        phone: data.get("phone") || undefined,
        password: data.get("password"),
      }),
    });
    if (res.ok) {
      const next = form.dataset.next;
      window.location.href = next && next.startsWith("/") ? next : "/profile";
    } else {
      const body = (await res.json().catch(() => ({}))) as { error?: string };
      errorEl.textContent = body.error ?? "Алдаа гарлаа";
      errorEl.classList.remove("hidden");
    }
  });
</script>
