---
import AppLayout from "../../layouts/AppLayout.astro";
import { loadCurrentUser } from "../../lib/auth";
import { listMyEvents } from "../../lib/db";
import { styleFor, formatDate, formatTime } from "../../lib/eventStyles";

const env = Astro.locals.runtime.env;
const me = await loadCurrentUser(
  env.DB,
  env.SESSIONS,
  Astro.request.headers.get("cookie"),
);

if (!me) {
  return Astro.redirect("/profile/login?next=/profile/my-events");
}

const tabParam = Astro.url.searchParams.get("when");
const activeTab: "upcoming" | "past" = tabParam === "past" ? "past" : "upcoming";

const all = await listMyEvents(env.DB, me.id);
const now = Math.floor(Date.now() / 1000);
const upcoming = all.filter((e) => e.start_at >= now);
const past = all.filter((e) => e.start_at < now);
const items = activeTab === "upcoming" ? upcoming : past;

const tabs = [
  { key: "upcoming", label: "Удахгүй", count: upcoming.length, href: "/profile/my-events" },
  { key: "past", label: "Өнгөрсөн", count: past.length, href: "/profile/my-events?when=past" },
];
---

<AppLayout title="Миний үйл ажиллагаа" activeTab="profile" showHeader={false}>
  <header class="px-3 pt-6 pb-3 flex items-center bg-white border-b border-gray-100 sticky top-0 z-20">
    <a href="/profile" aria-label="Буцах" class="p-2">
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M15 19l-7-7 7-7"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
    </a>
    <h1 class="flex-1 text-center text-lg font-bold">Миний үйл ажиллагаа</h1>
    <div class="w-10"></div>
  </header>

  <nav class="px-5 border-b border-gray-100 flex items-center gap-1">
    {
      tabs.map((t) => {
        const active = t.key === activeTab;
        return (
          <a
            href={t.href}
            class={`flex-1 text-center py-3 text-sm font-semibold relative ${
              active ? "text-mwa-burgundy" : "text-gray-400"
            }`}
          >
            {t.label}{" "}
            <span class="text-[10px] opacity-70">({t.count})</span>
            {active && (
              <span class="absolute bottom-0 left-1/4 right-1/4 h-[3px] bg-mwa-burgundy rounded-t-full" />
            )}
          </a>
        );
      })
    }
  </nav>

  <section class="px-5 pt-4 pb-10 space-y-2">
    {
      items.length === 0 && (
        <div class="text-center py-12">
          <div class="w-16 h-16 mx-auto bg-gray-50 rounded-full flex items-center justify-center mb-3">
            <svg
              class="w-8 h-8 text-gray-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
              />
            </svg>
          </div>
          <p class="text-sm text-gray-400 mb-3">
            {activeTab === "upcoming"
              ? "Бүртгүүлсэн арга хэмжээ алга."
              : "Өнгөрсөн арга хэмжээ алга."}
          </p>
          {activeTab === "upcoming" && (
            <a
              href="/events"
              class="inline-block text-mwa-burgundy font-bold text-xs"
            >
              Арга хэмжээ үзэх →
            </a>
          )}
        </div>
      )
    }
    {
      items.map((row) => {
        const s = styleFor(row.type);
        return (
          <a
            href={`/events/${row.id}`}
            class="block bg-white border border-gray-100 rounded-2xl shadow-sm p-4"
          >
            <div class="flex items-start justify-between gap-2 mb-2">
              <span
                class={`text-[10px] font-bold px-1.5 py-0.5 rounded ${s.chip}`}
              >
                {s.label}
              </span>
              <span class="text-[10px] text-mwa-burgundy font-bold">
                ✓ Бүртгэлтэй
              </span>
            </div>
            <h3 class="font-bold text-sm leading-tight mb-2">{row.title}</h3>
            <div class="grid grid-cols-2 gap-2 text-[11px] text-gray-500">
              <div>📅 {formatDate(row.start_at)}</div>
              <div>🕐 {formatTime(row.start_at)}</div>
              {row.location && (
                <div class="col-span-2 truncate">📍 {row.location}</div>
              )}
            </div>
          </a>
        );
      })
    }
  </section>
</AppLayout>
