---
import AppLayout from "../../layouts/AppLayout.astro";
import { loadCurrentUser } from "../../lib/auth";
import {
  getActiveMembership,
  listUserMembershipPayments,
  type MembershipPaymentRow,
} from "../../lib/db";
import { getPlan, formatTugrik } from "../../lib/membership";

const env = Astro.locals.runtime.env;
const me = await loadCurrentUser(
  env.DB,
  env.SESSIONS,
  Astro.request.headers.get("cookie"),
);

// Logged-in: real data; dev demo: fake an active 6m record + 1 past order.
let active: MembershipPaymentRow | null = null;
let payments: MembershipPaymentRow[] = [];
let userId = 123;
let userName = "Б. Энхжаргал";

if (me) {
  userId = me.id;
  userName = me.name;
  active = await getActiveMembership(env.DB, me.id);
  payments = await listUserMembershipPayments(env.DB, me.id);
} else {
  const now = Math.floor(Date.now() / 1000);
  const sixMo = 86400 * 30 * 6;
  active = {
    id: 9001,
    user_id: 123,
    plan_id: "6m",
    months: 6,
    amount: 60000,
    reference: "MWA-DEMO01",
    customer_memo: userName,
    payment_method: "bank_transfer",
    status: "confirmed",
    created_at: now - sixMo / 2,
    confirmed_at: now - sixMo / 2,
    starts_at: now - sixMo / 2,
    ends_at: now + sixMo / 2,
    admin_note: null,
  };
  payments = [
    active,
    {
      ...active,
      id: 9000,
      reference: "MWA-DEMO00",
      status: "confirmed",
      amount: 60000,
      created_at: now - sixMo * 1.5,
      confirmed_at: now - sixMo * 1.5,
      starts_at: now - sixMo * 1.5,
      ends_at: now - sixMo / 2,
    },
  ];
}

const memberNumber = `MG1924-${String(userId).padStart(6, "0")}`;

const pad = (n: number) => String(n).padStart(2, "0");
function fmtDate(unix: number): string {
  const d = new Date(unix * 1000);
  return `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())}`;
}
function fmtDateTime(unix: number): string {
  const d = new Date(unix * 1000);
  return `${fmtDate(unix)} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
}
function daysBetween(a: number, b: number): number {
  return Math.max(0, Math.ceil((b - a) / 86400));
}
const today = Math.floor(Date.now() / 1000);
const daysRemaining =
  active && active.ends_at ? daysBetween(today, active.ends_at) : 0;

const statusInfo: Record<
  string,
  { label: string; badge: string; ring: string }
> = {
  pending: {
    label: "Хүлээгдэж буй",
    badge: "bg-mwa-burgundy/10 text-mwa-burgundy",
    ring: "border-mwa-burgundy/20",
  },
  confirmed: {
    label: "Баталгаажсан",
    badge: "bg-emerald-50 text-emerald-700",
    ring: "border-emerald-100",
  },
  rejected: {
    label: "Татгалзсан",
    badge: "bg-rose-50 text-rose-600",
    ring: "border-rose-100",
  },
};
---

<AppLayout title="Миний гишүүнчлэл" activeTab="profile" showHeader={false}>
  <header class="lg:hidden px-3 pt-6 pb-3 flex items-center"
    data-purpose="my-membership-header"
  >
    <a href="/profile" aria-label="Буцах" class="p-2">
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M15 19l-7-7 7-7"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
    </a>
    <h1 class="flex-1 text-center text-lg font-bold">Миний гишүүнчлэл</h1>
    <div class="w-10"></div>
  </header>

  <div data-pc-wrapper class="lg:max-w-3xl lg:mx-auto lg:px-8 lg:py-6 lg:bg-white lg:my-6 lg:rounded-2xl lg:border lg:border-gray-100 lg:shadow-sm">

  <section class="px-5 mb-6" data-purpose="active-card">
    {
      active ? (
        <div class="bg-mwa-burgundy text-white rounded-2xl overflow-hidden shadow-md">
          <div class="p-5">
            <div class="flex items-center gap-2 mb-3">
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-300" />
              <span class="text-[11px] font-bold uppercase tracking-wider">
                Идэвхтэй гишүүн
              </span>
              <span class="ml-auto text-[10px] font-bold bg-white/15 rounded-full px-2 py-0.5">
                {getPlan(active.plan_id)?.label ?? active.plan_id}
              </span>
            </div>

            <div class="space-y-1 mb-4">
              <div class="text-[11px] opacity-80">Эрхийн хугацаа</div>
              <div class="font-extrabold text-base leading-tight">
                {active.starts_at ? fmtDate(active.starts_at) : "-"}
                <span class="opacity-70 mx-1">→</span>
                {active.ends_at ? fmtDate(active.ends_at) : "-"}
              </div>
              <div class="text-xs opacity-90">
                Үлдсэн{" "}
                <strong class="text-base font-extrabold">
                  {daysRemaining}
                </strong>{" "}
                өдөр
              </div>
            </div>

            <div class="border-t border-white/15 pt-3 grid grid-cols-2 gap-3 text-xs">
              <div>
                <div class="opacity-70 text-[10px] mb-0.5">Гишүүний дугаар</div>
                <div class="font-bold font-mono">{memberNumber}</div>
              </div>
              <div>
                <div class="opacity-70 text-[10px] mb-0.5">Төлсөн дүн</div>
                <div class="font-bold">{formatTugrik(active.amount)}</div>
              </div>
            </div>
          </div>
          <a
            href="/membership"
            class="block text-center bg-white/15 hover:bg-white/25 py-3.5 text-sm font-bold active:opacity-80 transition-colors"
          >
            Эрх сунгах →
          </a>
        </div>
      ) : (
        <div class="bg-gradient-to-br from-mwa-burgundy/5 to-purple-100/50 border border-mwa-burgundy/20 rounded-2xl p-5 text-center">
          <div class="w-12 h-12 rounded-full bg-mwa-burgundy/10 text-mwa-burgundy flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="3" y="6" width="18" height="13" rx="2" stroke-width="2" />
              <path d="M3 10h18" stroke-width="2" />
            </svg>
          </div>
          <div class="font-bold text-sm mb-1">Идэвхтэй гишүүнчлэл байхгүй</div>
          <p class="text-xs text-mwa-text-secondary mb-4 leading-relaxed">
            Гишүүн болсноор бүх контент, арга хэмжээ, сургалтад хандах
            боломжтой.
          </p>
          <a
            href="/membership"
            class="inline-block bg-mwa-burgundy text-white text-sm font-bold rounded-xl px-6 py-3 active:opacity-80"
          >
            Эрх авах
          </a>
        </div>
      )
    }
  </section>

  {
    payments.length > 0 && (
      <section class="px-5 mb-8" data-purpose="payments-history">
        <h2 class="font-bold text-base mb-3">Захиалгын түүх</h2>
        <div class="space-y-2">
          {payments.map((p) => {
            const plan = getPlan(p.plan_id);
            const s = statusInfo[p.status] ?? statusInfo.pending;
            const isCurrent = active && p.id === active.id;
            return (
              <a
                href={
                  p.status === "pending"
                    ? `/membership/pending/${p.id}`
                    : `/membership/pending/${p.id}`
                }
                class={`block bg-white border rounded-2xl shadow-sm p-4 active:bg-gray-50 ${s.ring}`}
              >
                <div class="flex items-start justify-between gap-2 mb-2">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 mb-1 flex-wrap">
                      <span class="font-bold text-sm">
                        {plan?.label ?? p.plan_id}
                      </span>
                      {isCurrent && (
                        <span class="text-[9px] font-bold text-mwa-burgundy bg-mwa-burgundy/10 rounded-full px-2 py-0.5">
                          ОДОО ИДЭВХТЭЙ
                        </span>
                      )}
                    </div>
                    <div class="text-[10px] text-gray-400 font-mono">
                      {p.reference}
                    </div>
                  </div>
                  <span
                    class={`text-[10px] font-bold px-2 py-1 rounded-full whitespace-nowrap shrink-0 ${s.badge}`}
                  >
                    {s.label}
                  </span>
                </div>

                <div class="grid grid-cols-2 gap-2 text-xs mt-3">
                  <div>
                    <div class="text-gray-400 text-[10px]">Дүн</div>
                    <div class="font-bold text-mwa-burgundy">
                      {formatTugrik(p.amount)}
                    </div>
                  </div>
                  <div>
                    <div class="text-gray-400 text-[10px]">Захиалсан</div>
                    <div class="font-semibold">{fmtDateTime(p.created_at)}</div>
                  </div>
                  {p.status === "confirmed" && p.starts_at && p.ends_at && (
                    <div class="col-span-2 pt-2 border-t border-gray-100">
                      <div class="text-gray-400 text-[10px]">Хүчинтэй хугацаа</div>
                      <div class="font-semibold">
                        {fmtDate(p.starts_at)} → {fmtDate(p.ends_at)}
                      </div>
                    </div>
                  )}
                  {p.status === "rejected" && p.admin_note && (
                    <div class="col-span-2 pt-2 border-t border-gray-100">
                      <div class="text-gray-400 text-[10px]">Татгалзсан шалтгаан</div>
                      <div class="font-semibold text-rose-600">
                        {p.admin_note}
                      </div>
                    </div>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  {
    active && (
      <section class="px-5 mb-10" data-purpose="extend-cta">
        <a
          href="/membership"
          class="block text-center bg-white border-2 border-mwa-burgundy text-mwa-burgundy font-bold rounded-2xl py-3.5 text-sm active:opacity-80"
        >
          Шинэ эрх авах
        </a>
      </section>
    )
  }
  </div>
</AppLayout>
