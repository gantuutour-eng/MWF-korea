---
import AppLayout from "../../layouts/AppLayout.astro";
import { loadCurrentUser } from "../../lib/auth";
import { getActiveMembership } from "../../lib/db";
import { getPlan } from "../../lib/membership";

const env = Astro.locals.runtime.env;
const user = await loadCurrentUser(
  env.DB,
  env.SESSIONS,
  Astro.request.headers.get("cookie"),
);

// Dev mode: show demo profile if not logged in so the page is browsable without auth.
const profile = user ?? {
  id: 123,
  name: "Б. Энхжаргал",
  email: null,
  avatar_url: null,
  role: "member" as const,
};

const memberNumber = `MG1924-${String(profile.id).padStart(6, "0")}`;

// Membership status — fetched for logged-in users, faked for the dev demo.
type MembershipBar = {
  planLabel: string;
  startLabel: string;
  endLabel: string;
  daysRemaining: number;
};
const fmt = (unix: number) => {
  const d = new Date(unix * 1000);
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
};
const now = Math.floor(Date.now() / 1000);
let membership: MembershipBar | null = null;
if (user) {
  const row = await getActiveMembership(env.DB, user.id);
  if (row && row.starts_at && row.ends_at) {
    const plan = getPlan(row.plan_id);
    membership = {
      planLabel: plan?.label ?? row.plan_id,
      startLabel: fmt(row.starts_at),
      endLabel: fmt(row.ends_at),
      daysRemaining: Math.max(0, Math.ceil((row.ends_at - now) / 86400)),
    };
  }
} else {
  // Demo: pretend the demo user is mid-way through a 6-month plan.
  const sixMo = 86400 * 30 * 6;
  const startUnix = now - sixMo / 2;
  const endUnix = now + sixMo / 2;
  membership = {
    planLabel: "6 сарын эрх",
    startLabel: fmt(startUnix),
    endLabel: fmt(endUnix),
    daysRemaining: Math.ceil((endUnix - now) / 86400),
  };
}

interface MenuItem {
  label: string;
  href: string;
  icon: string;
}

const menu: MenuItem[] = [
  {
    label: "Хувийн мэдээлэл",
    href: "/profile/info",
    icon: '<path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  },
  {
    label: "Гишүүнчлэл",
    href: "/profile/membership",
    icon: '<rect x="3" y="6" width="18" height="13" rx="2" stroke-width="2"/><path d="M3 10h18" stroke-width="2"/><path d="M8 4v2M16 4v2" stroke-linecap="round" stroke-width="2"/>',
  },
  {
    label: "Миний үйл ажиллагаа",
    href: "/profile/my-events",
    icon: '<path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  },
  {
    label: "Хадгалсан мэдээ",
    href: "/profile/saved",
    icon: '<path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3-7 3V5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  },
  {
    label: "Тохиргоо",
    href: "/profile/settings",
    icon: '<circle cx="12" cy="12" r="3" stroke-width="2"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  },
];
---

<AppLayout title="Миний профайл" activeTab="profile" showHeader={false}>
  <header
    class="px-3 pt-6 pb-3 flex items-center"
    data-purpose="profile-header"
  >
    <a href="/" aria-label="Буцах" class="p-2">
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M15 19l-7-7 7-7"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
    </a>
    <h1 class="flex-1 text-center text-lg font-bold">Миний профайл</h1>
    <div class="w-10"></div>
  </header>

  <section class="text-center pt-2 pb-5" data-purpose="profile-identity">
    <div
      class="w-28 h-28 rounded-full overflow-hidden bg-gray-100 mx-auto border border-gray-100"
    >
      <img
        src={profile.avatar_url ?? "/images/avatar-placeholder.svg"}
        alt=""
        class="w-full h-full object-cover"
      />
    </div>
    <div class="text-mwa-burgundy font-extrabold text-xl mt-3">
      {profile.name}
    </div>
  </section>

  <section class="px-5 mb-6" data-purpose="profile-membership">
    {
      membership ? (
        <div class="bg-mwa-burgundy text-white rounded-2xl overflow-hidden shadow-md">
          <a
            href="/profile/membership"
            class="block p-4 active:bg-mwa-burgundy/90 transition-colors"
          >
            <div class="flex items-center gap-2 mb-2.5">
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-300" />
              <span class="text-[11px] font-bold uppercase tracking-wider">
                Идэвхтэй гишүүн
              </span>
              <span class="text-xs font-semibold opacity-90">
                · {membership.planLabel}
              </span>
              <svg
                class="w-4 h-4 opacity-70 ml-auto"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M9 5l7 7-7 7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                />
              </svg>
            </div>
            <div class="font-extrabold text-sm leading-tight mb-1">
              {membership.startLabel}
              <span class="opacity-70 mx-1">→</span>
              {membership.endLabel}
            </div>
            <div class="text-[11px] opacity-85 flex items-center gap-1.5">
              <span class="font-mono opacity-90">{memberNumber}</span>
              <span class="opacity-50">·</span>
              <span>
                Үлдсэн{" "}
                <strong class="font-extrabold">
                  {membership.daysRemaining}
                </strong>{" "}
                өдөр
              </span>
            </div>
          </a>
          <a
            href="/membership"
            class="block text-center bg-white/15 hover:bg-white/25 py-3 text-xs font-bold active:opacity-80 transition-colors border-t border-white/10"
          >
            Эрх сунгах →
          </a>
        </div>
      ) : (
        <div class="bg-gradient-to-r from-mwa-burgundy/5 to-purple-100/60 border border-mwa-burgundy/20 rounded-2xl p-4 flex items-center justify-between gap-3">
          <div class="min-w-0">
            <div class="text-[11px] font-bold text-mwa-burgundy uppercase tracking-wider mb-0.5">
              Гишүүнчлэлгүй
            </div>
            <div class="text-xs text-mwa-text-secondary">
              Бүх боломжийг ашиглахын тулд гишүүн болоорой
            </div>
          </div>
          <a
            href="/membership"
            class="bg-mwa-burgundy text-white text-xs font-bold rounded-lg px-4 py-2.5 shrink-0 active:opacity-80 whitespace-nowrap"
          >
            Эрх авах
          </a>
        </div>
      )
    }
  </section>

  <section
    class="px-5 divide-y divide-gray-100 border-y border-gray-100"
    data-purpose="profile-menu"
  >
    {
      menu.map((item) => (
        <a
          href={item.href}
          class="flex items-center justify-between py-4 active:bg-gray-50"
        >
          <div class="flex items-center gap-3">
            <svg
              class="w-5 h-5 text-mwa-text-secondary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              set:html={item.icon}
            />
            <span class="text-sm text-mwa-text-primary">{item.label}</span>
          </div>
          <svg
            class="w-4 h-4 text-gray-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M9 5l7 7-7 7"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            />
          </svg>
        </a>
      ))
    }
  </section>

  {
    user?.role === "admin" && (
      <section class="px-5 mt-4" data-purpose="profile-admin">
        <a
          href="/admin"
          class="flex items-center gap-3 bg-mwa-burgundy text-white rounded-2xl p-4 shadow-sm active:opacity-90"
        >
          <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center shrink-0">
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
              />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="font-bold text-sm">Админ панель</div>
            <div class="text-[11px] opacity-80">
              Чат, төлбөр, мэдээ, хөтөлбөрүүдийг удирдах
            </div>
          </div>
          <svg
            class="w-4 h-4 opacity-80"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M9 5l7 7-7 7"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            />
          </svg>
        </a>
      </section>
    )
  }

  <section class="px-5 mt-3 mb-10" data-purpose="profile-logout">
    {
      user ? (
        <form method="POST" action="/api/auth/logout">
          <button
            type="submit"
            class="w-full flex items-center gap-3 py-4 active:bg-gray-50 text-left"
          >
            <svg
              class="w-5 h-5 text-mwa-text-secondary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
              />
            </svg>
            <span class="text-sm text-mwa-text-primary">Гарах</span>
          </button>
        </form>
      ) : (
        <a
          href="/profile/login?next=/profile"
          class="w-full flex items-center gap-3 py-4 active:bg-gray-50"
        >
          <svg
            class="w-5 h-5 text-mwa-text-secondary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M11 16l-4-4m0 0l4-4m-4 4h14m-6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            />
          </svg>
          <span class="text-sm text-mwa-text-primary">Нэвтрэх</span>
        </a>
      )
    }
  </section>
</AppLayout>
