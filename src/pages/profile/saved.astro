---
import AppLayout from "../../layouts/AppLayout.astro";
import { loadCurrentUser } from "../../lib/auth";
import { listSavedNews } from "../../lib/db";

const env = Astro.locals.runtime.env;
const me = await loadCurrentUser(
  env.DB,
  env.SESSIONS,
  Astro.request.headers.get("cookie"),
);

if (!me) {
  return Astro.redirect("/profile/login?next=/profile/saved");
}

const items = await listSavedNews(env.DB, me.id);

function fmtDate(unix: number): string {
  const d = new Date(unix * 1000);
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
}
---

<AppLayout title="Хадгалсан мэдээ" activeTab="profile" showHeader={false}>
  <header class="lg:hidden px-3 pt-6 pb-3 flex items-center bg-white border-b border-gray-100 sticky top-0 z-20">
    <a href="/profile" aria-label="Буцах" class="p-2">
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M15 19l-7-7 7-7"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
    </a>
    <h1 class="flex-1 text-center text-lg font-bold">Хадгалсан мэдээ</h1>
    <div class="w-10"></div>
  </header>

  <div data-pc-wrapper class="lg:max-w-3xl lg:mx-auto lg:px-8 lg:py-6 lg:bg-white lg:my-6 lg:rounded-2xl lg:border lg:border-gray-100 lg:shadow-sm">

  <section class="px-5 pt-4 pb-10 space-y-3">
    {
      items.length === 0 && (
        <div class="text-center py-12">
          <div class="w-16 h-16 mx-auto bg-gray-50 rounded-full flex items-center justify-center mb-3">
            <svg
              class="w-8 h-8 text-gray-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3-7 3V5z"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
              />
            </svg>
          </div>
          <p class="text-sm text-gray-400 mb-3">
            Одоогоор хадгалсан мэдээ алга.
          </p>
          <a
            href="/news"
            class="inline-block text-mwa-burgundy font-bold text-xs"
          >
            Мэдээ үзэх →
          </a>
        </div>
      )
    }
    {
      items.map((row) => (
        <a href={`/news/${row.id}`} class="flex items-start gap-4 group">
          <div class="shrink-0 w-24 h-24 rounded-2xl overflow-hidden bg-gray-100">
            {row.image_url ? (
              <img
                src={row.image_url}
                alt=""
                loading="lazy"
                class="w-full h-full object-cover"
              />
            ) : (
              <div class="w-full h-full bg-mwa-burgundy/10 flex items-center justify-center text-mwa-burgundy/40 text-xs">
                MWA
              </div>
            )}
          </div>
          <div class="flex-1 min-w-0 pt-1">
            <h2 class="font-bold text-[15px] leading-snug text-mwa-text-primary line-clamp-2 mb-2 group-active:opacity-70">
              {row.title}
            </h2>
            <div class="text-xs text-gray-400">
              💾 {fmtDate(row.saved_at)} хадгалсан
            </div>
          </div>
        </a>
      ))
    }
  </section>
  </div>
</AppLayout>
