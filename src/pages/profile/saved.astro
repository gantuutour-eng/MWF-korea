---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Хадгалсан мэдээ" activeTab="profile" showHeader={false}>
  <header class="px-3 pt-6 pb-3 flex items-center">
    <a href="/profile" aria-label="Буцах" class="p-2">
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M15 19l-7-7 7-7"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
    </a>
    <h1 class="flex-1 text-center text-lg font-bold">Хадгалсан мэдээ</h1>
    <div class="w-10"></div>
  </header>

  <section class="px-5 py-12 text-center text-gray-400 text-sm">
    Хадгалсан мэдээний жагсаалт удахгүй нэмэгдэнэ.
  </section>
</AppLayout>
