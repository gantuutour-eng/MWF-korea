---
import AppLayout from "../../layouts/AppLayout.astro";
import { loadCurrentUser } from "../../lib/auth";

const env = Astro.locals.runtime.env;
const me = await loadCurrentUser(
  env.DB,
  env.SESSIONS,
  Astro.request.headers.get("cookie"),
);

if (!me) {
  return Astro.redirect("/profile/login?next=/profile/info");
}

const hasPassword = me.password_hash !== null;
const memberNumber = `MG1924-${String(me.id).padStart(6, "0")}`;
---

<AppLayout title="Хувийн мэдээлэл" activeTab="profile" showHeader={false}>
  <header class="px-3 pt-6 pb-3 flex items-center bg-white border-b border-gray-100 sticky top-0 z-20">
    <a href="/profile" aria-label="Буцах" class="p-2">
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M15 19l-7-7 7-7"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
    </a>
    <h1 class="flex-1 text-center text-lg font-bold">Хувийн мэдээлэл</h1>
    <div class="w-10"></div>
  </header>

  <section class="px-5 pt-6 pb-2 flex items-center gap-4" data-purpose="identity">
    <div class="w-16 h-16 rounded-full overflow-hidden bg-gray-100 shrink-0">
      <img
        src={me.avatar_url ?? "/images/avatar-placeholder.svg"}
        alt=""
        class="w-full h-full object-cover"
      />
    </div>
    <div class="min-w-0">
      <div class="font-bold text-mwa-burgundy">{me.name}</div>
      <div class="text-xs text-gray-500 font-mono">{memberNumber}</div>
      <div class="text-[10px] text-gray-400 mt-0.5">
        {me.role === "admin" ? "Админ" : "Гишүүн"} ·{" "}
        {hasPassword ? "Имэйл/нууц үг" : "Google-р нэвтэрсэн"}
      </div>
    </div>
  </section>

  <form
    id="info-form"
    class="px-5 mt-4 space-y-4"
    onsubmit="return false"
    data-purpose="info-form"
  >
    <h2 class="font-bold text-sm text-mwa-text-secondary uppercase tracking-wide">
      Үндсэн мэдээлэл
    </h2>

    <div>
      <label class="text-xs font-bold text-mwa-text-secondary mb-1.5 block">
        Имэйл (солих боломжгүй)
      </label>
      <input
        type="email"
        value={me.email}
        readonly
        disabled
        class="w-full bg-gray-100 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-500"
      />
    </div>

    <div>
      <label class="text-xs font-bold text-mwa-text-secondary mb-1.5 block">
        Нэр <span class="text-rose-500">*</span>
      </label>
      <input
        name="name"
        type="text"
        required
        maxlength="60"
        value={me.name}
        class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-mwa-burgundy"
      />
    </div>

    <div>
      <label class="text-xs font-bold text-mwa-text-secondary mb-1.5 block">
        Утас
      </label>
      <input
        name="phone"
        type="tel"
        maxlength="30"
        value={me.phone ?? ""}
        placeholder="010-XXXX-XXXX"
        class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-mwa-burgundy"
      />
    </div>

    <p id="info-msg" class="text-sm text-center hidden" data-info-msg></p>

    <button
      type="submit"
      class="w-full bg-mwa-burgundy text-white font-bold py-3 rounded-xl text-sm active:opacity-80 disabled:opacity-50"
    >
      Хадгалах
    </button>
  </form>

  <form
    id="password-form"
    class="px-5 mt-8 space-y-4 pb-10"
    onsubmit="return false"
    data-purpose="password-form"
  >
    <h2 class="font-bold text-sm text-mwa-text-secondary uppercase tracking-wide">
      {hasPassword ? "Нууц үг солих" : "Нууц үг тохируулах"}
    </h2>

    {
      hasPassword ? (
        <div>
          <label class="text-xs font-bold text-mwa-text-secondary mb-1.5 block">
            Одоогийн нууц үг <span class="text-rose-500">*</span>
          </label>
          <input
            name="current_password"
            type="password"
            required
            autocomplete="current-password"
            class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-mwa-burgundy"
          />
        </div>
      ) : (
        <p class="text-xs text-mwa-text-secondary leading-relaxed bg-gray-50 rounded-xl p-3">
          Та одоо Google-аар нэвтэрсэн байна. Нууц үг үүсгэснээр имэйл/нууц
          үгээр нэмэлт нэвтэрч болно.
        </p>
      )
    }

    <div>
      <label class="text-xs font-bold text-mwa-text-secondary mb-1.5 block">
        Шинэ нууц үг (8+ тэмдэгт) <span class="text-rose-500">*</span>
      </label>
      <input
        name="new_password"
        type="password"
        required
        minlength="8"
        autocomplete="new-password"
        class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-mwa-burgundy"
      />
    </div>

    <p id="password-msg" class="text-sm text-center hidden" data-password-msg></p>

    <button
      type="submit"
      class="w-full bg-white border border-mwa-burgundy text-mwa-burgundy font-bold py-3 rounded-xl text-sm active:opacity-80 disabled:opacity-50"
    >
      {hasPassword ? "Нууц үг солих" : "Нууц үг үүсгэх"}
    </button>
  </form>
</AppLayout>

<script>
  interface ApiResponse {
    ok?: boolean;
    error?: string;
  }

  function showMsg(el: HTMLElement | null, text: string, ok: boolean) {
    if (!el) return;
    el.textContent = text;
    el.classList.remove("hidden", "text-rose-500", "text-emerald-600");
    el.classList.add(ok ? "text-emerald-600" : "text-rose-500");
    window.setTimeout(() => el.classList.add("hidden"), 4000);
  }

  // Personal info form
  const infoForm = document.getElementById("info-form") as HTMLFormElement | null;
  const infoMsg = document.querySelector<HTMLElement>("[data-info-msg]");
  infoForm?.addEventListener("submit", async () => {
    if (!infoForm) return;
    const btn = infoForm.querySelector<HTMLButtonElement>(
      "button[type='submit']",
    );
    if (btn) btn.disabled = true;
    const data = new FormData(infoForm);
    try {
      const res = await fetch("/api/profile/info", {
        method: "PATCH",
        credentials: "same-origin",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          name: String(data.get("name") ?? "").trim(),
          phone: String(data.get("phone") ?? "").trim(),
        }),
      });
      const body = (await res.json().catch(() => ({}))) as ApiResponse;
      if (res.ok && body.ok) {
        showMsg(infoMsg, "Амжилттай хадгалагдлаа", true);
      } else {
        showMsg(infoMsg, body.error ?? "Алдаа гарлаа", false);
      }
    } catch {
      showMsg(infoMsg, "Сүлжээний алдаа", false);
    } finally {
      if (btn) btn.disabled = false;
    }
  });

  // Password form
  const pwForm = document.getElementById("password-form") as HTMLFormElement | null;
  const pwMsg = document.querySelector<HTMLElement>("[data-password-msg]");
  pwForm?.addEventListener("submit", async () => {
    if (!pwForm) return;
    const btn = pwForm.querySelector<HTMLButtonElement>(
      "button[type='submit']",
    );
    if (btn) btn.disabled = true;
    const data = new FormData(pwForm);
    const payload: { current_password?: string; new_password: string } = {
      new_password: String(data.get("new_password") ?? ""),
    };
    const cur = String(data.get("current_password") ?? "");
    if (cur) payload.current_password = cur;
    try {
      const res = await fetch("/api/profile/password", {
        method: "POST",
        credentials: "same-origin",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      const body = (await res.json().catch(() => ({}))) as ApiResponse;
      if (res.ok && body.ok) {
        showMsg(pwMsg, "Нууц үг шинэчлэгдлээ", true);
        pwForm.reset();
      } else {
        showMsg(pwMsg, body.error ?? "Алдаа гарлаа", false);
      }
    } catch {
      showMsg(pwMsg, "Сүлжээний алдаа", false);
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
