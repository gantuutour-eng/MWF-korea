---
import AppLayout from "../../layouts/AppLayout.astro";
import {
  getEvent,
  getAdjacentEvents,
  isEventBookmarked,
} from "../../lib/db";
import { loadCurrentUser } from "../../lib/auth";
import { styleFor, formatDate, formatTime } from "../../lib/eventStyles";

const env = Astro.locals.runtime.env;
const id = Number(Astro.params.id);
let row = null;
if (Number.isFinite(id)) {
  row = await getEvent(env.DB, id);
}

if (!row) {
  return Astro.redirect("/events");
}

const me = await loadCurrentUser(
  env.DB,
  env.SESSIONS,
  Astro.request.headers.get("cookie"),
);
const initiallyBookmarked = me
  ? await isEventBookmarked(env.DB, me.id, row.id)
  : false;

const { prev, next } = await getAdjacentEvents(env.DB, {
  id: row.id,
  start_at: row.start_at,
});

const style = styleFor(row.type);
const startDate = new Date(row.start_at * 1000);
const endDate = row.end_at ? new Date(row.end_at * 1000) : null;
const weekdayLabels = ["Ня", "Да", "Мя", "Лх", "Пү", "Ба", "Бя"];
const startWeekday = weekdayLabels[startDate.getDay()];
const dateLine = `${formatDate(row.start_at)} (${startWeekday})`;
const timeLine = endDate
  ? `${formatTime(row.start_at)} – ${formatTime(row.end_at!)}`
  : formatTime(row.start_at);

const prevStyle = prev ? styleFor(prev.type) : null;
const nextStyle = next ? styleFor(next.type) : null;
---

<AppLayout
  title={row.title}
  activeTab="events"
  showHeader={false}
  showBottomNav={false}
>
  <header
    class="px-3 pt-6 pb-2 flex items-center justify-between"
    data-purpose="detail-header"
  >
    <a href="/events" aria-label="Буцах" class="p-2">
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M15 19l-7-7 7-7"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
    </a>
    <div class="flex items-center gap-1">
      <button
        type="button"
        aria-label="Хуваалцах"
        class="flex items-center gap-1.5 px-3 py-2 rounded-full text-gray-600 hover:bg-gray-100 active:bg-gray-200 transition"
        data-action="share"
        data-share-title={row.title}
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            d="M4 12v.01M4 12c0-1.105.895-2 2-2s2 .895 2 2-.895 2-2 2-2-.895-2-2zM15 8l-7 4m0 0l7 4M8 12c0 1.105-.895 2-2 2"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"></path>
        </svg>
        <span class="text-xs font-semibold">Хуваалцах</span>
      </button>
      <button
        type="button"
        aria-label="Хадгалах"
        class={`flex items-center gap-1.5 px-3 py-2 rounded-full transition ${
          initiallyBookmarked
            ? "text-mwa-burgundy bg-mwa-burgundy/10"
            : "text-gray-600 hover:bg-gray-100 active:bg-gray-200"
        }`}
        data-action="bookmark"
        data-event-id={String(row.id)}
        data-bookmarked={initiallyBookmarked ? "1" : "0"}
        data-logged-in={me ? "1" : "0"}
      >
        <svg
          class="h-5 w-5"
          fill={initiallyBookmarked ? "currentColor" : "none"}
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3-7 3V5z"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"></path>
        </svg>
        <span class="text-xs font-semibold" data-bookmark-label>
          {initiallyBookmarked ? "Хадгалсан" : "Хадгалах"}
        </span>
      </button>
    </div>
  </header>

  <section class="px-5" data-purpose="detail-cover">
    <div class="relative aspect-[16/9] rounded-2xl overflow-hidden bg-gray-100">
      {
        row.image_url ? (
          <img
            src={row.image_url}
            alt=""
            class="w-full h-full object-cover"
          />
        ) : (
          <div class={`w-full h-full bg-gradient-to-br ${style.featuredBg}`} />
        )
      }
      <span
        class={`absolute top-3 left-3 text-[11px] font-bold px-3 py-1 rounded-full ${style.chip}`}
      >
        {style.label}
      </span>
    </div>
  </section>

  <h1 class="px-5 mt-5 text-2xl font-extrabold leading-tight">
    {row.title}
  </h1>

  <section
    class="px-5 mt-5 space-y-2"
    data-purpose="detail-meta"
  >
    <div class="flex items-center gap-3 bg-gray-50 p-3 rounded-xl">
      <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center text-base">
        📅
      </div>
      <div class="flex-1">
        <div class="text-[11px] text-gray-500">Огноо</div>
        <div class="font-semibold text-sm">{dateLine}</div>
      </div>
    </div>
    <div class="flex items-center gap-3 bg-gray-50 p-3 rounded-xl">
      <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center text-base">
        🕐
      </div>
      <div class="flex-1">
        <div class="text-[11px] text-gray-500">Цаг</div>
        <div class="font-semibold text-sm">{timeLine}</div>
      </div>
    </div>
    {
      row.location && (
        <div class="flex items-center gap-3 bg-gray-50 p-3 rounded-xl">
          <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center text-base">
            📍
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-[11px] text-gray-500">Байршил</div>
            <div class="font-semibold text-sm">{row.location}</div>
          </div>
        </div>
      )
    }
  </section>

  {
    row.description && (
      <section class="px-5 mt-6" data-purpose="detail-body">
        <h2 class="font-bold text-base mb-2">Дэлгэрэнгүй</h2>
        <p class="text-sm text-gray-700 whitespace-pre-line leading-relaxed">
          {row.description}
        </p>
      </section>
    )
  }

  {
    (prev || next) && (
      <nav
        class="px-5 mt-8 pb-10 space-y-3"
        aria-label="Бусад арга хэмжээ"
        data-purpose="event-nav"
      >
        <h2 class="font-bold text-base">Бусад арга хэмжээ</h2>

        {prev && prevStyle && (
          <a
            href={`/events/${prev.id}`}
            class="flex items-center gap-3 bg-white border border-gray-100 rounded-2xl p-3 shadow-sm active:opacity-80 hover:border-mwa-burgundy/30 transition"
          >
            <div class="w-14 h-14 shrink-0 rounded-xl overflow-hidden bg-gray-100 relative">
              {prev.image_url ? (
                <img src={prev.image_url} alt="" class="w-full h-full object-cover" />
              ) : (
                <div class={`w-full h-full bg-gradient-to-br ${prevStyle.featuredBg}`} />
              )}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1 text-[10px] font-bold text-gray-400 mb-0.5">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
                </svg>
                ӨМНӨХ
              </div>
              <div class="text-sm font-bold leading-snug line-clamp-2">
                {prev.title}
              </div>
              <div class="text-[11px] text-gray-500 mt-0.5">
                {formatDate(prev.start_at)}
              </div>
            </div>
          </a>
        )}

        {next && nextStyle && (
          <a
            href={`/events/${next.id}`}
            class="flex items-center gap-3 bg-white border border-gray-100 rounded-2xl p-3 shadow-sm active:opacity-80 hover:border-mwa-burgundy/30 transition"
          >
            <div class="w-14 h-14 shrink-0 rounded-xl overflow-hidden bg-gray-100 relative">
              {next.image_url ? (
                <img src={next.image_url} alt="" class="w-full h-full object-cover" />
              ) : (
                <div class={`w-full h-full bg-gradient-to-br ${nextStyle.featuredBg}`} />
              )}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1 text-[10px] font-bold text-mwa-burgundy mb-0.5">
                ДАРААГИЙН
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
                </svg>
              </div>
              <div class="text-sm font-bold leading-snug line-clamp-2">
                {next.title}
              </div>
              <div class="text-[11px] text-gray-500 mt-0.5">
                {formatDate(next.start_at)}
              </div>
            </div>
          </a>
        )}

        <a
          href="/events"
          class="block text-center text-sm font-semibold text-mwa-burgundy py-3"
        >
          Бүх арга хэмжээ →
        </a>
      </nav>
    )
  }

  <div
    id="toast"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 bg-mwa-text-primary text-white text-xs font-semibold rounded-full shadow-lg opacity-0 pointer-events-none transition-opacity duration-200"
    role="status"
    aria-live="polite"
  >
  </div>
</AppLayout>

<script>
  const toast = document.getElementById("toast");
  let toastTimer: number | null = null;

  function showToast(text: string) {
    if (!toast) return;
    toast.textContent = text;
    toast.classList.remove("opacity-0");
    toast.classList.add("opacity-100");
    if (toastTimer) window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.classList.remove("opacity-100");
      toast.classList.add("opacity-0");
    }, 1800);
  }

  document
    .querySelectorAll<HTMLButtonElement>('[data-action="share"]')
    .forEach((btn) => {
      btn.addEventListener("click", async () => {
        const title = btn.dataset.shareTitle ?? document.title;
        const url = window.location.href;
        if (navigator.share) {
          try {
            await navigator.share({ title, url });
            return;
          } catch {
            // user cancelled — fall through to clipboard fallback
          }
        }
        if (navigator.clipboard) {
          try {
            await navigator.clipboard.writeText(url);
            showToast("Холбоос хуулагдлаа");
            return;
          } catch {
            // ignore
          }
        }
        showToast("Хуваалцах боломжгүй");
      });
    });

  document
    .querySelectorAll<HTMLButtonElement>('[data-action="bookmark"]')
    .forEach((btn) => {
      const eventId = btn.dataset.eventId;
      const loggedIn = btn.dataset.loggedIn === "1";
      const labelEl = btn.querySelector<HTMLElement>("[data-bookmark-label]");
      const svg = btn.querySelector<SVGElement>("svg");

      const applyState = (on: boolean) => {
        btn.dataset.bookmarked = on ? "1" : "0";
        btn.classList.toggle("text-mwa-burgundy", on);
        btn.classList.toggle("bg-mwa-burgundy/10", on);
        btn.classList.toggle("text-gray-600", !on);
        btn.classList.toggle("hover:bg-gray-100", !on);
        btn.classList.toggle("active:bg-gray-200", !on);
        if (labelEl) labelEl.textContent = on ? "Хадгалсан" : "Хадгалах";
        if (svg) svg.setAttribute("fill", on ? "currentColor" : "none");
      };

      btn.addEventListener("click", async () => {
        if (!loggedIn) {
          const next = encodeURIComponent(window.location.pathname);
          window.location.href = `/profile/login?next=${next}`;
          return;
        }
        if (!eventId) return;
        btn.disabled = true;
        try {
          const res = await fetch(`/api/events/${eventId}/bookmark`, {
            method: "POST",
            credentials: "same-origin",
          });
          const data = (await res.json().catch(() => ({}))) as {
            ok?: boolean;
            bookmarked?: boolean;
            error?: string;
          };
          if (res.ok && data.ok) {
            const on = data.bookmarked === true;
            applyState(on);
            showToast(on ? "Хадгалагдлаа" : "Хадгалалт цуцлагдсан");
          } else if (data.error) {
            showToast(data.error);
          }
        } catch {
          showToast("Сүлжээний алдаа");
        } finally {
          btn.disabled = false;
        }
      });
    });
</script>
