---
import AppLayout from "../../layouts/AppLayout.astro";
import { listEvents, listEventsInRange } from "../../lib/db";
import { styleFor, formatDate, formatTime } from "../../lib/eventStyles";
import {
  todaySeoul,
  wallClockSeoulToUnix,
  toIsoDate,
  getYMD,
} from "../../lib/datetime";

type When = "all" | "upcoming" | "past";
const whenParam = Astro.url.searchParams.get("when");
const activeWhen: When =
  whenParam === "upcoming" || whenParam === "past" ? whenParam : "all";

// ---------- Calendar state from URL ----------
// `?date=YYYY-MM-DD` filters the event list to that day; the calendar shows
// the month containing the date.
// `?month=YYYY-MM` switches the calendar view without filtering.
const dateParam = Astro.url.searchParams.get("date");
const monthParam = Astro.url.searchParams.get("month");

const today = todaySeoul();
const isoDateRe = /^(\d{4})-(\d{2})-(\d{2})$/;
const isoMonthRe = /^(\d{4})-(\d{2})$/;

let selectedYMD: { y: number; m: number; d: number } | null = null;
if (dateParam && isoDateRe.test(dateParam)) {
  const [, y, mo, d] = dateParam.match(isoDateRe)!;
  selectedYMD = { y: +y, m: +mo, d: +d };
}

let calMonth: { y: number; m: number };
if (selectedYMD) {
  calMonth = { y: selectedYMD.y, m: selectedYMD.m };
} else if (monthParam && isoMonthRe.test(monthParam)) {
  const [, y, mo] = monthParam.match(isoMonthRe)!;
  calMonth = { y: +y, m: +mo };
} else {
  calMonth = { y: today.y, m: today.m };
}

// ---------- Fetch events ----------
let rows = await listEvents(Astro.locals.runtime.env.DB, {
  when: activeWhen === "all" ? "upcoming" : activeWhen,
});

// Apply day filter if active.
if (selectedYMD) {
  const start = wallClockSeoulToUnix(selectedYMD.y, selectedYMD.m, selectedYMD.d, 0, 0);
  const end = start + 24 * 3600;
  rows = rows.filter((r) => r.start_at >= start && r.start_at < end);
}

// Days in the displayed month that have events (for dot indicators).
const monthStart = wallClockSeoulToUnix(calMonth.y, calMonth.m, 1, 0, 0);
const nextMonth = calMonth.m === 12
  ? { y: calMonth.y + 1, m: 1 }
  : { y: calMonth.y, m: calMonth.m + 1 };
const monthEnd = wallClockSeoulToUnix(nextMonth.y, nextMonth.m, 1, 0, 0);
const eventsThisMonth = await listEventsInRange(
  Astro.locals.runtime.env.DB,
  monthStart,
  monthEnd,
);
const daysWithEvents = new Set<number>();
for (const e of eventsThisMonth) {
  daysWithEvents.add(getYMD(e.start_at).d);
}

// ---------- Calendar grid ----------
// Mon-start week.
const firstDay = new Date(Date.UTC(calMonth.y, calMonth.m - 1, 1));
const firstWeekday = (firstDay.getUTCDay() + 6) % 7; // 0=Mon..6=Sun
const daysInMonth = new Date(Date.UTC(calMonth.y, calMonth.m, 0)).getUTCDate();
const prevMonthLastDay = new Date(Date.UTC(calMonth.y, calMonth.m - 1, 0)).getUTCDate();

interface CalCell {
  day: number;
  inMonth: boolean;
  isToday: boolean;
  isSelected: boolean;
  hasEvent: boolean;
  isSunday: boolean;
  href: string;
}
const calCells: CalCell[] = [];
const totalCells = Math.ceil((firstWeekday + daysInMonth) / 7) * 7;
for (let i = 0; i < totalCells; i++) {
  let cellY = calMonth.y;
  let cellM = calMonth.m;
  let cellDay: number;
  let inMonth = true;
  if (i < firstWeekday) {
    cellDay = prevMonthLastDay - firstWeekday + 1 + i;
    inMonth = false;
    if (cellM === 1) {
      cellY -= 1;
      cellM = 12;
    } else {
      cellM -= 1;
    }
  } else if (i - firstWeekday >= daysInMonth) {
    cellDay = i - firstWeekday - daysInMonth + 1;
    inMonth = false;
    if (cellM === 12) {
      cellY += 1;
      cellM = 1;
    } else {
      cellM += 1;
    }
  } else {
    cellDay = i - firstWeekday + 1;
  }

  const isToday =
    inMonth &&
    cellY === today.y &&
    cellM === today.m &&
    cellDay === today.d;
  const isSelected =
    !!selectedYMD &&
    cellY === selectedYMD.y &&
    cellM === selectedYMD.m &&
    cellDay === selectedYMD.d;
  const hasEvent = inMonth && daysWithEvents.has(cellDay);
  const isSunday = i % 7 === 6;
  const iso = `${cellY}-${String(cellM).padStart(2, "0")}-${String(cellDay).padStart(2, "0")}`;
  const params = new URLSearchParams();
  if (activeWhen !== "all") params.set("when", activeWhen);
  // Clicking the currently-selected day clears the filter.
  if (!isSelected) params.set("date", iso);
  else params.set("month", `${cellY}-${String(cellM).padStart(2, "0")}`);
  const qs = params.toString();
  const href = qs ? `/events?${qs}` : "/events";

  calCells.push({
    day: cellDay,
    inMonth,
    isToday,
    isSelected,
    hasEvent,
    isSunday,
    href,
  });
}

// Prev/next month navigation links.
const prevMonthYM =
  calMonth.m === 1
    ? { y: calMonth.y - 1, m: 12 }
    : { y: calMonth.y, m: calMonth.m - 1 };
const nextMonthYM =
  calMonth.m === 12
    ? { y: calMonth.y + 1, m: 1 }
    : { y: calMonth.y, m: calMonth.m + 1 };

function navHref(ym: { y: number; m: number }): string {
  const params = new URLSearchParams();
  if (activeWhen !== "all") params.set("when", activeWhen);
  params.set("month", `${ym.y}-${String(ym.m).padStart(2, "0")}`);
  return `/events?${params.toString()}`;
}

const monthLabel = `${calMonth.y} оны ${calMonth.m}-р сар`;
const weekdayLabels = ["Да", "Мя", "Лх", "Пү", "Ба", "Бя", "Ня"];

const featured = selectedYMD ? rows : rows.slice(0, 3);
const others = selectedYMD ? [] : rows.slice(3);

const tabs: { key: When; label: string }[] = [
  { key: "all", label: "Бүгд" },
  { key: "upcoming", label: "Удахгүй болох" },
  { key: "past", label: "Өнгөрсөн" },
];

const featuredHeading = selectedYMD
  ? `${toIsoDate(wallClockSeoulToUnix(selectedYMD.y, selectedYMD.m, selectedYMD.d, 0, 0))}-ны үйл ажиллагаа`
  : "Удахгүй болох үйл ажиллагаа";

const clearFilterHref = (() => {
  const params = new URLSearchParams();
  if (activeWhen !== "all") params.set("when", activeWhen);
  const qs = params.toString();
  return qs ? `/events?${qs}` : "/events";
})();
---

<AppLayout title="Үйл ажиллагаа" activeTab="events" showHeader={false}>
  <header
    class="px-3 pt-6 pb-3 flex items-center"
    data-purpose="events-header"
  >
    <a href="/" aria-label="Буцах" class="p-2">
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
      </svg>
    </a>
    <h1 class="flex-1 text-center text-lg font-bold">Үйл ажиллагаа</h1>
    <div class="w-10"></div>
  </header>

  <nav
    class="px-5 border-b border-gray-100 flex items-center gap-2"
    data-purpose="events-tabs"
  >
    {
      tabs.map((tab) => {
        const active = tab.key === activeWhen;
        const params = new URLSearchParams();
        if (tab.key !== "all") params.set("when", tab.key);
        if (dateParam && isoDateRe.test(dateParam)) params.set("date", dateParam);
        else if (monthParam && isoMonthRe.test(monthParam)) params.set("month", monthParam);
        const qs = params.toString();
        const href = qs ? `/events?${qs}` : "/events";
        return (
          <a
            href={href}
            class={`flex-1 text-center py-3 text-sm font-semibold relative ${
              active ? "text-mwa-burgundy" : "text-gray-400"
            }`}
          >
            {tab.label}
            {active && (
              <span class="absolute bottom-0 left-1/4 right-1/4 h-[3px] bg-mwa-burgundy rounded-t-full" />
            )}
          </a>
        );
      })
    }
  </nav>

  {/* ---------- Month calendar ---------- */}
  <section class="px-5 pt-4 pb-2" data-purpose="month-calendar">
    <div class="flex items-center justify-between mb-3">
      <a
        href={navHref(prevMonthYM)}
        aria-label="Өмнөх сар"
        class="p-1.5 text-gray-500 hover:text-mwa-burgundy active:text-mwa-burgundy"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M15 19l-7-7 7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <span class="text-sm font-bold">{monthLabel}</span>
      <a
        href={navHref(nextMonthYM)}
        aria-label="Дараах сар"
        class="p-1.5 text-gray-500 hover:text-mwa-burgundy active:text-mwa-burgundy"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M9 5l7 7-7 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-7 text-center text-[11px] text-gray-400 mb-2">
      {
        weekdayLabels.map((l, i) => (
          <div class={i === 6 ? "text-rose-500" : ""}>{l}</div>
        ))
      }
    </div>

    <div class="grid grid-cols-7 text-center">
      {
        calCells.map((c) => (
          <a
            href={c.href}
            class="relative py-1 flex items-center justify-center"
            aria-label={`${c.day}-ны өдөр`}
          >
            <span
              class={`relative inline-flex items-center justify-center w-9 h-9 rounded-full text-sm transition-colors ${
                c.isSelected
                  ? "bg-mwa-burgundy text-white font-bold"
                  : c.isToday
                    ? "border-2 border-mwa-burgundy text-mwa-burgundy font-bold"
                    : c.inMonth
                      ? c.isSunday
                        ? "text-rose-500"
                        : "text-mwa-text-primary"
                      : "text-gray-300"
              }`}
            >
              {c.day}
              {c.hasEvent && (
                <span
                  class={`absolute -bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full ${
                    c.isSelected ? "bg-white" : "bg-mwa-burgundy"
                  }`}
                />
              )}
            </span>
          </a>
        ))
      }
    </div>

    {selectedYMD && (
      <div class="mt-3 flex items-center justify-center">
        <a
          href={clearFilterHref}
          class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-mwa-burgundy bg-mwa-burgundy/5 border border-mwa-burgundy/20 rounded-full px-3 py-1.5"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M6 18L18 6M6 6l12 12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Шүүлтийг арилгах
        </a>
      </div>
    )}
  </section>

  {
    featured.length > 0 && (
      <section class="px-5 mt-4" data-purpose="featured-events">
        <div class="flex items-center justify-between mb-3">
          <h2 class="font-bold text-base">{featuredHeading}</h2>
          {!selectedYMD && (
            <a
              href="/events?when=upcoming"
              class="text-xs text-gray-400 font-medium"
            >
              Бүгдийг харах →
            </a>
          )}
        </div>

        <div class="space-y-3">
          {featured.map((row) => {
            const s = styleFor(row.type);
            return (
              <a
                href={`/events/${row.id}`}
                class="flex bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100"
              >
                <div
                  class={`w-[120px] shrink-0 p-3 bg-gradient-to-br ${s.featuredBg} text-white flex flex-col`}
                >
                  <span class="inline-block self-start text-[10px] font-bold bg-white/20 backdrop-blur rounded px-2 py-0.5">
                    {s.label}
                  </span>
                  <div class="flex-1 my-2 font-extrabold text-[13px] leading-tight line-clamp-3">
                    {row.title}
                  </div>
                  <div class={`text-[10px] pt-2 border-t ${s.accent}`}>
                    <div class="opacity-90">{formatDate(row.start_at)}</div>
                    <div class="font-bold">{formatTime(row.start_at)}</div>
                  </div>
                </div>
                <div class="flex-1 p-3 min-w-0">
                  <h3 class="font-bold text-sm leading-snug line-clamp-2 mb-1.5">
                    {row.title}
                  </h3>
                  {row.location && (
                    <p class="text-[11px] text-gray-500 leading-snug flex items-start gap-1 mb-1.5 line-clamp-2">
                      <span aria-hidden="true">📍</span>
                      <span class="flex-1">{row.location}</span>
                    </p>
                  )}
                  {row.description && (
                    <p class="text-[11px] text-gray-600 line-clamp-2 leading-snug mb-2">
                      {row.description}
                    </p>
                  )}
                  <div class="flex gap-1.5">
                    <span class="text-[10px] font-bold border border-gray-300 text-gray-500 px-2 py-1 rounded-md">
                      Дэлгэрэнгүй
                    </span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  {
    others.length > 0 && (
      <section class="px-5 mt-8" data-purpose="other-events">
        <h2 class="font-bold text-base mb-3">Бусад үйл ажиллагаа</h2>
        <div class="divide-y divide-gray-100">
          {others.map((row) => {
            const s = styleFor(row.type);
            return (
              <a
                href={`/events/${row.id}`}
                class="flex items-center gap-3 py-3"
              >
                <div class="w-16 h-16 shrink-0 rounded-xl overflow-hidden bg-gray-100">
                  {row.image_url ? (
                    <img
                      src={row.image_url}
                      alt=""
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full bg-mwa-burgundy/10 flex items-center justify-center text-mwa-burgundy/40 text-[10px]">
                      MWA
                    </div>
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <span
                    class={`inline-block text-[10px] font-bold px-1.5 py-0.5 rounded ${s.chip}`}
                  >
                    {s.label}
                  </span>
                  <h3 class="font-semibold text-sm leading-tight mt-1 line-clamp-1">
                    {row.title}
                  </h3>
                  <div class="text-[11px] text-gray-500 mt-0.5 flex items-center gap-2">
                    <span>📅 {formatDate(row.start_at)}</span>
                    <span>🕐 {formatTime(row.start_at)}</span>
                    {row.location && (
                      <span class="truncate">📍 {row.location}</span>
                    )}
                  </div>
                </div>
                <svg
                  class="w-4 h-4 text-gray-300 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M9 5l7 7-7 7"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  {
    rows.length === 0 && (
      <div class="text-center py-12 text-gray-400 text-sm px-5">
        {selectedYMD
          ? "Энэ өдөр арга хэмжээ алга байна."
          : "Одоогоор арга хэмжээ алга байна."}
      </div>
    )
  }
</AppLayout>
