---
import AppLayout from "../layouts/AppLayout.astro";
import HeroBanner from "../components/HeroBanner.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import NewsCarousel from "../components/NewsCarousel.astro";
import SectionTitle from "../components/SectionTitle.astro";
import GridCard from "../components/GridCard.astro";
import { listNews, listHeroSlides } from "../lib/db";

const env = Astro.locals.runtime.env;
const [latestNews, dbSlides] = await Promise.all([
  listNews(env.DB, { limit: 6 }),
  listHeroSlides(env.DB),
]);

const DEFAULT_HERO_SLIDES = [
  {
    title: "Эвлэлдэн нэгдэж<br/>Ирээдүйг бүтээе",
    subtitle: "1924 оноос эхтэй<br/>бидний түүх",
  },
  {
    title: "Сургалт,<br/>семинарт оролц",
    subtitle: "Хэлний, ур чадварын<br/>сургалтууд",
    href: "/events?type=training",
  },
  {
    title: "Гишүүнчлэлд<br/>элсэх",
    subtitle: "Гишүүний бүх<br/>боломжийг ашигла",
    href: "/membership",
  },
];

const heroSlides =
  dbSlides.length > 0
    ? dbSlides.map((s) => ({
        title: s.title,
        subtitle: s.subtitle,
        href: s.href,
        image_url: s.image_url,
      }))
    : DEFAULT_HERO_SLIDES;

const menu = [
  {
    href: "/news",
    label: "Мэдээ<br/>мэдээлэл",
    iconSrc: "/images/icons/news.png",
  },
  {
    href: "/events",
    label: "Үйл<br/>ажиллагаа",
    iconSrc: "/images/icons/activities.png",
  },
  {
    href: "/portfolio",
    label: "Хийгдсэн<br/>ажлууд",
    iconSrc: "/images/icons/done.png",
  },
  {
    href: "/membership",
    label: "Гишүүнчлэл",
    iconSrc: "/images/icons/membership.png",
  },
  {
    href: "/advice",
    label: "Зөвлөгөө,<br/>дэмжлэг",
    iconSrc: "/images/icons/advice.png",
  },
  {
    href: "/about",
    label: "Бидний тухай",
    iconSrc: "/images/icons/about.png",
  },
];
---

<AppLayout activeTab="home">
  <HeroCarousel slides={heroSlides} />

  <SectionTitle title="Үйл ажиллагаа" viewAllHref="/events" />

  <section class="px-5 lg:px-8 mb-8" data-purpose="menu-grid">
    <div
      class="grid grid-cols-3 lg:grid-cols-6 gap-x-4 gap-y-5 lg:max-w-4xl lg:mx-auto"
    >
      {
        menu.map((item) => (
          <GridCard
            href={item.href}
            label={item.label}
            iconSrc={item.iconSrc}
          />
        ))
      }
    </div>
  </section>

  <NewsCarousel items={latestNews} />

  <HeroBanner
    variant="secondary"
    title="Эмэгтэйчүүдийн эрх"
    subtitle="Таны боломж, Таны ирээдүй"
    href="/about"
  />

  <footer
    class="px-5 lg:px-8 pt-8 pb-4 text-center"
    data-purpose="home-footer"
  >
    <div class="text-[11px] text-gray-400 leading-relaxed">
      <div class="font-bold text-mwa-burgundy/80 mb-1">
        Монголын эмэгтэйчүүдийн холбоо
      </div>
      <div>БНСУ дахь салбар зөвлөл</div>
    </div>
    <nav
      class="flex items-center justify-center gap-3 mt-4 text-[12px]"
      aria-label="Хуудасны нөхцөлийн холбоосууд"
    >
      <a href="/privacy" class="text-gray-500 hover:text-mwa-burgundy">
        Нууцлалын бодлого
      </a>
      <span class="text-gray-300">·</span>
      <a href="/terms" class="text-gray-500 hover:text-mwa-burgundy">
        Үйлчилгээний нөхцөл
      </a>
      <span class="text-gray-300">·</span>
      <a href="/about" class="text-gray-500 hover:text-mwa-burgundy">
        Бидний тухай
      </a>
    </nav>
    <div class="text-[10px] text-gray-400 mt-3">
      © 2026 MWA Korea. All rights reserved.
    </div>
  </footer>
</AppLayout>
