---
import AppLayout from "../../layouts/AppLayout.astro";
import { PLANS, BENEFITS, formatTugrik } from "../../lib/membership";

const toneStyles = {
  pink: {
    card: "bg-gradient-to-br from-pink-50 to-pink-100/70 border-pink-200/80",
    iconTile: "bg-mwa-burgundy text-white",
    badge: "bg-mwa-burgundy text-white",
    priceColor: "text-mwa-burgundy",
    divider: "border-mwa-burgundy/10",
    button: "bg-mwa-burgundy text-white",
  },
  purple: {
    card: "bg-gradient-to-br from-purple-50 to-purple-100/70 border-purple-200/80",
    iconTile: "bg-purple-800 text-white",
    badge: "bg-purple-800 text-white",
    priceColor: "text-purple-800",
    divider: "border-purple-800/10",
    button: "bg-purple-800 text-white",
  },
} as const;
---

<AppLayout title="Гишүүнчлэл" activeTab="profile" showHeader={false}>
  <header
    class="lg:hidden px-3 pt-6 pb-3 flex items-center"
    data-purpose="membership-header"
  >
    <a href="/" aria-label="Буцах" class="p-2">
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M15 19l-7-7 7-7"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
    </a>
    <h1 class="flex-1 text-center text-lg font-bold">Гишүүнчлэл</h1>
    <div class="w-10"></div>
  </header>

  <div class="lg:max-w-5xl lg:mx-auto lg:px-8 lg:py-6">

  <section class="px-5 lg:px-0 mb-6" data-purpose="hero">
    <div
      class="relative bg-mwa-burgundy text-white rounded-[24px] p-5 pr-24 overflow-hidden"
    >
      <h2 class="text-2xl font-extrabold leading-tight mb-2">
        БНСУ дахь салбар зөвлөл
      </h2>
      <p class="text-sm opacity-90 leading-snug">
        Эмэгтэйчүүдийн эрх, эрх чөлөөний төлөөх монголын эмэгтэйчүүдийн
        холбооны БНСУ дахь салбар зөвлөл
      </p>
      <img
        src="/images/logo.png"
        alt=""
        class="absolute right-3 top-1/2 -translate-y-1/2 w-20 h-20 object-contain"
      />
    </div>
  </section>

  <section class="px-5 lg:px-0 mb-3" data-purpose="plans-intro">
    <h2 class="font-bold text-base mb-1">Гишүүнчлэлийн сонголт</h2>
    <p class="text-xs text-mwa-text-secondary">
      Та өөрт тохирох эрхээ сонгоно уу.
    </p>
  </section>

  <section
    class="px-5 lg:px-0 space-y-4 mb-8 lg:space-y-0 lg:grid lg:grid-cols-2 lg:gap-5"
    data-purpose="plans"
  >
    {
      PLANS.map((plan) => {
        const s = toneStyles[plan.tone];
        return (
          <article
            class={`relative rounded-2xl overflow-hidden border shadow-sm ${s.card}`}
          >
            <div class="p-5">
              <div class="flex items-start gap-3 mb-4">
                <div
                  class={`w-14 h-14 rounded-2xl flex flex-col items-center justify-center shrink-0 ${s.iconTile} shadow-sm`}
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                    />
                  </svg>
                  <span class="text-base font-extrabold leading-none mt-0.5">
                    {plan.calendarNumber}
                  </span>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap mb-1.5">
                    <h3 class={`text-lg font-extrabold ${s.priceColor}`}>
                      {plan.label}
                    </h3>
                    {plan.badgeText && (
                      <span
                        class={`text-[10px] font-bold px-2 py-0.5 rounded-full ${s.badge} whitespace-nowrap`}
                      >
                        ★ {plan.badgeText}
                      </span>
                    )}
                  </div>
                  <div class="flex items-baseline gap-1.5">
                    <span class={`text-3xl font-extrabold ${s.priceColor}`}>
                      {formatTugrik(plan.monthlyPrice)}
                    </span>
                    <span class="text-xs text-mwa-text-secondary">/ сард</span>
                  </div>
                  <div class="text-[11px] text-mwa-text-secondary mt-0.5">
                    Нийт төлбөр:{" "}
                    <strong class={`${s.priceColor}`}>
                      {formatTugrik(plan.totalPrice)}
                    </strong>
                  </div>
                </div>
              </div>

              <ul class={`space-y-2 pt-4 border-t ${s.divider}`}>
                {BENEFITS.map((b) => (
                  <li class="flex items-start gap-2 text-[13px] text-mwa-text-primary leading-snug">
                    <svg
                      class={`w-4 h-4 shrink-0 mt-0.5 ${s.priceColor}`}
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href={`/membership/checkout?plan=${plan.id}`}
              class={`flex items-center justify-center gap-2 font-bold py-4 ${s.button} active:opacity-90 transition-opacity`}
            >
              <span>{plan.label} авах</span>
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M14 5l7 7m0 0l-7 7m7-7H3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                />
              </svg>
            </a>
          </article>
        );
      })
    }
  </section>

  <section class="px-5 lg:px-0 mb-8" data-purpose="membership-info">
    <h2 class="font-bold text-base mb-3">Гишүүнчлэлийн талаар</h2>
    <div class="space-y-2.5 lg:space-y-0 lg:grid lg:grid-cols-2 lg:gap-3">
      <article class="bg-white border border-gray-100 rounded-2xl p-4 flex items-start gap-3">
        <div class="w-10 h-10 rounded-xl bg-mwa-burgundy/10 text-mwa-burgundy flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            />
          </svg>
        </div>
        <p class="text-sm text-mwa-text-primary leading-relaxed">
          Гишүүнчлэлийн хураамж нь <strong>сард 10,000₮</strong> бөгөөд 6 сар
          болон 1 жилийн эрхээр тооцогдоно.
        </p>
      </article>

      <article class="bg-white border border-gray-100 rounded-2xl p-4 flex items-start gap-3">
        <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            />
          </svg>
        </div>
        <p class="text-sm text-mwa-text-primary leading-relaxed">
          Гишүүнчлэлийн хугацаа нь <strong>төлбөр төлсөн өдрөөс</strong> эхлэн
          идэвхтэй болно.
        </p>
      </article>

      <article class="bg-white border border-gray-100 rounded-2xl p-4 flex items-start gap-3">
        <div class="w-10 h-10 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            />
          </svg>
        </div>
        <p class="text-sm text-mwa-text-primary leading-relaxed">
          БНСУ-д амьдарч буй <strong>гэр бүл, хүүхэд, эмэгтэйчүүдэд</strong>{" "}
          чиглэсэн сайн дурын сургалт, контент, хандивын үйл ажиллагаанд
          зарцуулагдана.
        </p>
      </article>

      <article class="bg-white border border-gray-100 rounded-2xl p-4 flex items-start gap-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              d="M9 17v-2a2 2 0 012-2h2a2 2 0 012 2v2m-9-4h12m-12-4h12m-12-4h12M5 19h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            />
          </svg>
        </div>
        <p class="text-sm text-mwa-text-primary leading-relaxed">
          <strong>Хагас жил тутам</strong> санхүүгийн тайлан гаргах бөгөөд
          шаардлагатай тохиолдолд хүссэн үедээ үзэх боломжтой.
        </p>
      </article>
    </div>
  </section>

  </div>
</AppLayout>
