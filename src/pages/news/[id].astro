---
import AppLayout from "../../layouts/AppLayout.astro";
import NewsGallery from "../../components/NewsGallery.astro";
import {
  getNews,
  listNews,
  listNewsImages,
  isNewsBookmarked,
} from "../../lib/db";
import { loadCurrentUser } from "../../lib/auth";

const env = Astro.locals.runtime.env;
const id = Number(Astro.params.id);
let row = null;
if (Number.isFinite(id)) {
  row = await getNews(env.DB, id);
}

if (!row) {
  return Astro.redirect("/news");
}

const galleryRows = await listNewsImages(env.DB, row.id);
const galleryImages = galleryRows.map((r) => r.url);
// Legacy posts (no news_images rows) still render via cover_url.
const fallbackImages = row.cover_url ? [row.cover_url] : [];
const images = galleryImages.length > 0 ? galleryImages : fallbackImages;

const related = await listNews(env.DB, {
  limit: 6,
  excludeId: row.id,
});

const me = await loadCurrentUser(
  env.DB,
  env.SESSIONS,
  Astro.request.headers.get("cookie"),
);
const initiallySaved = me
  ? await isNewsBookmarked(env.DB, me.id, row.id)
  : false;
---

<AppLayout title={row.title} activeTab="news" showHeader={false}>
  <header class="px-3 pt-6 pb-2 flex items-center" data-purpose="detail-header">
    <a
      href="/news"
      aria-label="Буцах"
      class="p-2"
    >
      <svg
        class="h-6 w-6 text-mwa-text-primary"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M15 19l-7-7 7-7"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
    </a>
  </header>

  <article class="pb-10 lg:max-w-3xl lg:mx-auto" data-purpose="article">
    <h1 class="px-5 text-[26px] font-extrabold leading-tight text-mwa-text-primary mb-4">
      {row.title}
    </h1>

    {images.length > 0 && <NewsGallery images={images} />}

    <div
      class="px-5 mt-4 flex items-center justify-end gap-5 text-gray-500"
      data-purpose="article-actions"
    >
      <button
        type="button"
        aria-label="Share"
        class="p-1 active:opacity-60"
        data-action="share"
        data-share-title={row.title}
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M8 12a4 4 0 11-8 0 4 4 0 018 0zm12-6a4 4 0 11-8 0 4 4 0 018 0zm0 12a4 4 0 11-8 0 4 4 0 018 0z"
            opacity="0"></path>
          <path
            d="M4 12v.01M4 12c0-1.105.895-2 2-2s2 .895 2 2-.895 2-2 2-2-.895-2-2zM15 8l-7 4m0 0l7 4M8 12c0 1.105-.895 2-2 2"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"></path>
        </svg>
      </button>
      <button
        type="button"
        aria-label="Хадгалах"
        class={`flex items-center gap-1.5 p-1 active:opacity-60 transition-colors ${initiallySaved ? "text-mwa-burgundy" : ""}`}
        data-action="bookmark"
        data-news-id={String(row.id)}
        data-bookmarked={initiallySaved ? "1" : "0"}
        data-logged-in={me ? "1" : "0"}
      >
        <svg
          class="w-6 h-6"
          fill={initiallySaved ? "currentColor" : "none"}
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3-7 3V5z"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"></path>
        </svg>
        <span class="text-xs font-semibold" data-bookmark-label>
          {initiallySaved ? "Хадгалсан" : "Хадгалах"}
        </span>
      </button>
    </div>

    {
      row.subtitle && (
        <h2 class="px-5 mt-6 text-lg font-bold leading-snug text-mwa-text-primary">
          {row.subtitle}
        </h2>
      )
    }

    <div
      class="px-5 mt-4 text-[15px] leading-relaxed text-mwa-text-secondary whitespace-pre-line"
    >
      {row.body}
    </div>
  </article>

  <section
    class="px-5 lg:px-8 mt-8 pb-10"
    aria-label="Бусад мэдээ"
    data-purpose="related-news"
  >
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-bold text-base">Бусад мэдээ</h2>
      <a href="/news" class="text-xs font-semibold text-mwa-burgundy">
        Бүгдийг харах →
      </a>
    </div>

    {
      related.length === 0 ? (
        <p class="text-sm text-gray-400">Одоогоор бусад мэдээ алга байна.</p>
      ) : (
        <ul class="space-y-3 lg:space-y-0 lg:grid lg:grid-cols-2 lg:gap-3">
          {related.map((n) => (
            <li>
              <a
                href={`/news/${n.id}`}
                class="flex items-center gap-3 bg-white border border-gray-100 rounded-2xl p-3 shadow-sm active:opacity-80 hover:border-mwa-burgundy/30 transition"
              >
                <div class="w-20 h-20 shrink-0 rounded-xl overflow-hidden bg-gray-100">
                  {n.cover_url ? (
                    <img
                      src={n.cover_url}
                      alt=""
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full bg-mwa-burgundy/10" />
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-bold leading-snug line-clamp-2 text-mwa-text-primary">
                    {n.title}
                  </div>
                  {n.subtitle && (
                    <div class="text-xs text-gray-500 mt-1 line-clamp-2">
                      {n.subtitle}
                    </div>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</AppLayout>

<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-action="share"]')
    .forEach((btn) => {
      btn.addEventListener("click", async () => {
        const title = btn.dataset.shareTitle ?? document.title;
        const url = window.location.href;
        if (navigator.share) {
          try {
            await navigator.share({ title, url });
          } catch {
            // user cancelled
          }
        } else if (navigator.clipboard) {
          try {
            await navigator.clipboard.writeText(url);
            btn.setAttribute("aria-label", "Copied");
          } catch {
            // ignore
          }
        }
      });
    });

  document
    .querySelectorAll<HTMLButtonElement>('[data-action="bookmark"]')
    .forEach((btn) => {
      const newsId = btn.dataset.newsId;
      const loggedIn = btn.dataset.loggedIn === "1";
      const labelEl = btn.querySelector<HTMLElement>("[data-bookmark-label]");
      const svg = btn.querySelector<SVGElement>("svg");

      btn.addEventListener("click", async () => {
        if (!loggedIn) {
          const next = encodeURIComponent(window.location.pathname);
          window.location.href = `/profile/login?next=${next}`;
          return;
        }
        if (!newsId) return;
        btn.disabled = true;
        try {
          const res = await fetch(`/api/news/${newsId}/bookmark`, {
            method: "POST",
            credentials: "same-origin",
          });
          const data = (await res.json().catch(() => ({}))) as {
            ok?: boolean;
            bookmarked?: boolean;
            error?: string;
          };
          if (res.ok && data.ok) {
            const on = data.bookmarked === true;
            btn.dataset.bookmarked = on ? "1" : "0";
            btn.classList.toggle("text-mwa-burgundy", on);
            if (labelEl) labelEl.textContent = on ? "Хадгалсан" : "Хадгалах";
            if (svg) svg.setAttribute("fill", on ? "currentColor" : "none");
          } else if (data.error) {
            alert(data.error);
          }
        } catch {
          // ignore transient
        } finally {
          btn.disabled = false;
        }
      });
    });
</script>
