---
import "../styles/global.css";
import AdminBottomNav from "../components/AdminBottomNav.astro";
import { countAdminUnreadChat, countPendingPayments } from "../lib/db";

type AdminNavKey =
  | "dashboard"
  | "users"
  | "chat"
  | "payments"
  | "news"
  | "events"
  | "portfolio"
  | "hero";

interface Props {
  title?: string;
  active?: AdminNavKey;
}

const { title = "Админ панель", active = "dashboard" } = Astro.props;

// Badge counts (chat unread + pending payments). Two small COUNT queries —
// shared across every admin page so the badges are always live.
const env = Astro.locals.runtime.env;
const [unreadChat, pendingPayments] = await Promise.all([
  countAdminUnreadChat(env.DB),
  countPendingPayments(env.DB),
]);

const badges: Partial<Record<AdminNavKey, number>> = {
  chat: unreadChat,
  payments: pendingPayments,
};

// Map admin nav key to the 5-tab mobile bottom nav. Sections that aren't on
// the bottom bar (news/portfolio/hero) keep dashboard highlighted as fallback.
type MobileTab = "dashboard" | "payments" | "chat" | "events" | "users";
const mobileTabMap: Record<AdminNavKey, MobileTab> = {
  dashboard: "dashboard",
  payments: "payments",
  chat: "chat",
  events: "events",
  users: "users",
  news: "dashboard",
  portfolio: "dashboard",
  hero: "dashboard",
};
const mobileActive = mobileTabMap[active];

const nav: { key: AdminNavKey; label: string; href: string; icon: string }[] = [
  {
    key: "dashboard",
    label: "Удирдлагын самбар",
    href: "/admin",
    icon: '<rect x="3" y="3" width="7" height="9" rx="1" stroke-width="2"/><rect x="14" y="3" width="7" height="5" rx="1" stroke-width="2"/><rect x="14" y="12" width="7" height="9" rx="1" stroke-width="2"/><rect x="3" y="16" width="7" height="5" rx="1" stroke-width="2"/>',
  },
  {
    key: "payments",
    label: "Төлбөр",
    href: "/admin/payments",
    icon: '<path d="M3 10h18M5 6h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  },
  {
    key: "chat",
    label: "Чат",
    href: "/admin/chat",
    icon: '<path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  },
  {
    key: "events",
    label: "Арга хэмжээ",
    href: "/admin/events",
    icon: '<path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  },
  {
    key: "news",
    label: "Мэдээ",
    href: "/admin/news",
    icon: '<path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10l4 4v10a2 2 0 01-2 2zM7 8h5m-5 4h5m-5 4h5" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  },
  {
    key: "portfolio",
    label: "Хийгдсэн ажлууд",
    href: "/admin/portfolio",
    icon: '<path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  },
  {
    key: "hero",
    label: "Үндсэн хуудасны баннер",
    href: "/admin/hero",
    icon: '<path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  },
  {
    key: "users",
    label: "Хэрэглэгчид",
    href: "/admin/users",
    icon: '<path d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6 5.87v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2m13-13a4 4 0 11-8 0 4 4 0 018 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  },
];
---

<!doctype html>
<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="font-sans text-mwa-text-primary antialiased bg-gray-50 lg:bg-gray-100"
  >
    <aside
      class="hidden lg:flex lg:flex-col lg:w-64 lg:fixed lg:inset-y-0 bg-white border-r border-gray-200 z-30"
      data-purpose="admin-sidebar"
    >
      <a
        href="/admin"
        class="px-5 py-5 border-b border-gray-100 flex items-center gap-3"
      >
        <img
          src="/images/logo.png"
          alt="MWA"
          class="w-10 h-10 object-contain shrink-0"
        />
        <div class="min-w-0">
          <div class="font-extrabold text-sm leading-tight truncate">MWA Korea</div>
          <div
            class="text-[10px] text-mwa-burgundy font-bold uppercase tracking-wider"
          >
            Админ панель
          </div>
        </div>
      </a>

      <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
        {
          nav.map((item) => {
            const isActive = active === item.key;
            const badge = badges[item.key];
            return (
              <a
                href={item.href}
                class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-semibold transition-colors ${
                  isActive
                    ? "bg-mwa-burgundy text-white shadow-sm"
                    : "text-gray-600 hover:bg-gray-100 hover:text-mwa-text-primary"
                }`}
              >
                <svg
                  class="w-5 h-5 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  set:html={item.icon}
                />
                <span class="flex-1">{item.label}</span>
                {badge !== undefined && badge > 0 && (
                  <span
                    class={`shrink-0 min-w-[20px] h-5 px-1.5 rounded-full text-[11px] font-bold flex items-center justify-center ${
                      isActive
                        ? "bg-white text-mwa-burgundy"
                        : "bg-mwa-burgundy text-white"
                    }`}
                  >
                    {badge > 99 ? "99+" : badge}
                  </span>
                )}
              </a>
            );
          })
        }
      </nav>

      <div class="px-3 py-3 border-t border-gray-100">
        <a
          href="/"
          class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-semibold text-gray-600 hover:bg-gray-100 hover:text-mwa-text-primary"
        >
          <svg
            class="w-5 h-5 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3v-6h6v6h3a1 1 0 001-1V10"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            ></path>
          </svg>
          <span>Сайт руу буцах</span>
        </a>
      </div>
    </aside>

    <main
      class="lg:pl-64 min-h-screen pb-24 lg:pb-0"
      data-purpose="admin-main"
    >
      <slot />
    </main>

    <AdminBottomNav
      active={mobileActive}
      badges={{ chat: unreadChat, payments: pendingPayments }}
    />
  </body>
</html>
