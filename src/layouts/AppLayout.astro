---
import "../styles/global.css";
import Header from "../components/Header.astro";
import BottomNav from "../components/BottomNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  activeTab?: "home" | "news" | "chat" | "events" | "profile";
  showHeader?: boolean;
  showBottomNav?: boolean;
}

const {
  title = "БНСУ дахь салбар зөвлөл",
  activeTab = "home",
  showHeader = true,
  showBottomNav = true,
} = Astro.props;
---

<!doctype html>
<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans text-mwa-text-primary antialiased bg-white lg:bg-mwa-cream">
    <main
      class="max-w-md lg:max-w-7xl mx-auto min-h-screen bg-white lg:bg-mwa-cream pb-24 lg:pb-0 relative overflow-x-hidden"
    >
      {/*
        Mobile: respect the page's showHeader prop (detail pages typically
        render their own back-arrow header instead of the global one).
        Desktop: always render the global header so users keep the primary
        nav strip available everywhere — getting stuck on a detail page
        with no way to navigate is worse than a small duplication.
      */}
      {showHeader ? (
        <Header />
      ) : (
        <div class="hidden lg:block">
          <Header />
        </div>
      )}
      <slot />
      <SiteFooter />
      {showBottomNav && <BottomNav active={activeTab} />}
    </main>
  </body>
</html>
