---
import "../styles/global.css";
import Header from "../components/Header.astro";
import BottomNav from "../components/BottomNav.astro";

interface Props {
  title?: string;
  activeTab?: "home" | "news" | "chat" | "events" | "profile";
  showHeader?: boolean;
  showBottomNav?: boolean;
}

const {
  title = "БНСУ дахь салбар зөвлөл",
  activeTab = "home",
  showHeader = true,
  showBottomNav = true,
} = Astro.props;
---

<!doctype html>
<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans text-mwa-text-primary antialiased bg-white lg:bg-gray-50">
    <main
      class="max-w-md lg:max-w-6xl mx-auto min-h-screen bg-white pb-24 lg:pb-16 relative overflow-x-hidden lg:shadow-sm"
    >
      {showHeader && <Header />}
      <slot />
      {showBottomNav && <BottomNav active={activeTab} />}
    </main>
  </body>
</html>
