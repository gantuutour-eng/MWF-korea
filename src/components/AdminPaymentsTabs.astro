---
type Tab = "orders" | "members" | "settings";

interface Props {
  active: Tab;
}

const { active } = Astro.props;

const tabs: { key: Tab; label: string; href: string; icon: string }[] = [
  {
    key: "orders",
    label: "Захиалга",
    href: "/admin/payments",
    icon: '<path d="M3 10h18M5 6h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  },
  {
    key: "members",
    label: "Гишүүд",
    href: "/admin/payments/members",
    icon: '<path d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6 5.87v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2m13-13a4 4 0 11-8 0 4 4 0 018 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  },
  {
    key: "settings",
    label: "Дансны мэдээлэл",
    href: "/admin/payments/settings",
    icon: '<path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
  },
];
---

<nav class="px-5 lg:px-0 mb-4 flex items-center gap-2 overflow-x-auto" aria-label="Төлбөрийн хэсгүүд">
  {
    tabs.map((t) => {
      const isActive = t.key === active;
      return (
        <a
          href={t.href}
          class={`flex items-center gap-2 px-3 py-2 rounded-xl text-sm font-bold whitespace-nowrap transition ${
            isActive
              ? "bg-mwa-burgundy text-white"
              : "bg-white text-gray-600 border border-gray-200 hover:border-mwa-burgundy/30 hover:text-mwa-burgundy"
          }`}
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            set:html={t.icon}
          />
          <span>{t.label}</span>
        </a>
      );
    })
  }
</nav>
