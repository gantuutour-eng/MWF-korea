---
import type { NewsRow } from "../lib/db";

interface Props {
  items: NewsRow[];
  heading?: string;
  emptyText?: string;
}

const {
  items,
  heading = "Мэдээ",
  emptyText = "Одоогоор мэдээ алга байна.",
} = Astro.props;

function leadParagraph(body: string): string {
  const lines = body.split(/\n+/).filter(Boolean);
  return lines[0]?.replace(/[#*>📌👇💬📅🎁🔹]/gu, "").trim() ?? "";
}
---

<section class="mb-8" data-purpose="news-carousel">
  <h2 class="px-5 text-lg font-bold mb-3">{heading}</h2>

  {
    items.length === 0 ? (
      <div class="px-5 text-sm text-gray-400">{emptyText}</div>
    ) : (
      <div
        class="news-track flex overflow-x-auto snap-x snap-mandatory scroll-smooth gap-4 px-5 pb-2"
        data-news-track
      >
        {items.map((row) => (
          <a
            href={`/news/${row.id}`}
            class="snap-start shrink-0 w-72 bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden flex flex-col"
          >
            <div class="relative h-44 bg-gray-100">
              {row.cover_url && (
                <img
                  src={row.cover_url}
                  alt=""
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover"
                />
              )}
              <div class="absolute inset-0 p-4 flex items-start">
                <h3
                  class="text-xl font-extrabold leading-tight text-white line-clamp-3"
                  style="text-shadow: 0 1px 3px rgba(0,0,0,0.55), 0 0 12px rgba(0,0,0,0.35)"
                >
                  {row.title}
                </h3>
              </div>
            </div>
            <div class="p-4 flex flex-col gap-1">
              <h4 class="font-bold text-sm leading-snug text-mwa-text-primary line-clamp-2">
                {row.subtitle ?? row.title}
              </h4>
              <p class="text-xs text-gray-500 line-clamp-2 leading-relaxed">
                {leadParagraph(row.body)}
              </p>
            </div>
          </a>
        ))}
      </div>
    )
  }
</section>

<style>
  .news-track {
    scrollbar-width: none;
  }
  .news-track::-webkit-scrollbar {
    display: none;
  }
</style>
