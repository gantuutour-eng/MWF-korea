---
interface Props {
  images: string[];
}

const { images } = Astro.props;
---

{
  images.length > 0 && (
    <section class="px-5" data-purpose="news-gallery">
      <div class="news-gallery relative" data-news-gallery>
        <div
          class="news-gallery-track flex overflow-x-auto snap-x snap-mandatory scroll-smooth -mx-1"
          data-news-gallery-track
        >
          {images.map((url) => (
            <div class="snap-center shrink-0 w-full px-1">
              <div class="rounded-2xl overflow-hidden bg-gray-100 aspect-[16/9]">
                <img
                  src={url}
                  alt=""
                  loading="lazy"
                  class="w-full h-full object-cover"
                />
              </div>
            </div>
          ))}
        </div>

        {images.length > 1 && (
          <>
            <div class="flex justify-center gap-1.5 mt-3" data-news-gallery-dots>
              {images.map((_, i) => (
                <button
                  type="button"
                  data-news-gallery-dot={i}
                  aria-label={`Зураг ${i + 1}`}
                  class="h-1.5 rounded-full bg-mwa-burgundy/30 transition-all"
                  style="width: 6px"
                />
              ))}
            </div>
            <span
              class="absolute top-3 right-4 z-10 text-[11px] font-bold bg-black/60 text-white px-2 py-0.5 rounded-full"
              data-news-gallery-counter
            >
              1 / {images.length}
            </span>
          </>
        )}
      </div>
    </section>
  )
}

<style>
  .news-gallery-track {
    scrollbar-width: none;
  }
  .news-gallery-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function initNewsGallery(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>("[data-news-gallery-track]");
    const dots = root.querySelectorAll<HTMLElement>("[data-news-gallery-dot]");
    const counter = root.querySelector<HTMLElement>("[data-news-gallery-counter]");
    if (!track) return;
    const total = track.children.length;
    if (total < 2) return;

    const update = () => {
      const slideWidth = track.clientWidth;
      const index = Math.min(
        total - 1,
        Math.max(0, Math.round(track.scrollLeft / slideWidth)),
      );
      dots.forEach((dot, i) => {
        if (i === index) {
          dot.style.width = "18px";
          dot.classList.remove("bg-mwa-burgundy/30");
          dot.classList.add("bg-mwa-burgundy");
        } else {
          dot.style.width = "6px";
          dot.classList.add("bg-mwa-burgundy/30");
          dot.classList.remove("bg-mwa-burgundy");
        }
      });
      if (counter) counter.textContent = `${index + 1} / ${total}`;
    };

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        track.scrollTo({ left: track.clientWidth * i, behavior: "smooth" });
      });
    });

    track.addEventListener("scroll", update, { passive: true });
    update();
  }

  document
    .querySelectorAll<HTMLElement>("[data-news-gallery]")
    .forEach(initNewsGallery);
</script>
