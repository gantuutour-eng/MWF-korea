---
import type { EventRow } from "../lib/db";
import { styleFor, formatDate, formatTime } from "../lib/eventStyles";

interface Props {
  events: EventRow[];
  /** Autoplay interval. Set 0 to disable. */
  autoplayMs?: number;
}

const { events, autoplayMs = 5500 } = Astro.props;
// Show up to 6 events so the dots row stays manageable.
const slides = events.slice(0, 6);
---

{
  slides.length > 0 && (
    <section
      class="events-banner px-5 lg:px-12 mb-8"
      data-events-banner
      data-autoplay-ms={autoplayMs}
      data-purpose="events-banner"
    >
      <div class="hidden lg:flex items-end justify-between mb-5 border-t border-mwa-ink/90 pt-6">
        <div>
          <span class="ed-label">Удахгүй болох · Events</span>
          <h2 class="text-3xl xl:text-4xl font-extrabold leading-tight tracking-tight text-mwa-ink mt-4">
            Манай хамтын ажиллагаа
          </h2>
        </div>
        <a
          href="/events"
          class="text-[12px] font-bold text-mwa-burgundy hover:underline shrink-0"
        >
          Бүх арга хэмжээ ›
        </a>
      </div>

      <div class="relative">
        <div
          class="events-banner-track flex overflow-x-auto snap-x snap-mandatory scroll-smooth -mx-1 lg:-mx-1.5"
          data-events-banner-track
        >
          {slides.map((row) => {
            const s = styleFor(row.type);
            return (
              <a
                href={`/events/${row.id}`}
                class="snap-center shrink-0 w-full px-1 lg:px-1.5 group"
              >
                <div
                  class={`relative bg-gradient-to-br ${s.featuredBg} rounded-[24px] lg:rounded-none overflow-hidden min-h-[140px] lg:min-h-[280px] text-white p-5 lg:p-10`}
                >
                  {row.image_url && (
                    <>
                      <img
                        src={row.image_url}
                        alt=""
                        class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-60 transition-opacity"
                      />
                      <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/30 to-black/40" />
                    </>
                  )}

                  <div class="relative z-10 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-3 lg:gap-8 h-full min-h-[100px] lg:min-h-[200px]">
                    <div class="flex-1 min-w-0 flex flex-col">
                      <div class="flex items-center gap-2 mb-2 lg:mb-3">
                        <span class="text-[10px] lg:text-[11px] font-bold tracking-[0.15em] uppercase bg-white/20 backdrop-blur px-2 py-1 rounded">
                          {s.label}
                        </span>
                        <span class="text-[10px] lg:text-[11px] font-mono opacity-80">
                          {formatDate(row.start_at)} · {formatTime(row.start_at)}
                        </span>
                      </div>

                      <h3 class="font-extrabold text-lg lg:text-3xl xl:text-4xl leading-tight tracking-tight line-clamp-2 mb-1 lg:mb-3">
                        {row.title}
                      </h3>

                      {row.location && (
                        <p class="text-xs lg:text-sm opacity-85 line-clamp-1 lg:line-clamp-2">
                          📍 {row.location}
                        </p>
                      )}

                      {row.description && (
                        <p class="hidden lg:block text-sm opacity-80 mt-2 line-clamp-2 max-w-2xl">
                          {row.description}
                        </p>
                      )}
                    </div>

                    <div class="flex items-center gap-2 text-xs lg:text-sm font-bold shrink-0 self-start lg:self-end pb-1">
                      <span class="border-b border-white pb-0.5">
                        Дэлгэрэнгүй
                      </span>
                      <span aria-hidden="true" class="text-lg lg:text-xl">›</span>
                    </div>
                  </div>
                </div>
              </a>
            );
          })}
        </div>

        {slides.length > 1 && (
          <div
            class="flex justify-center gap-1.5 mt-3 lg:mt-5"
            data-events-banner-dots
            aria-hidden="true"
          >
            {slides.map((_, i) => (
              <button
                type="button"
                data-events-banner-dot={i}
                aria-label={`Slide ${i + 1}`}
                class="h-1.5 rounded-full bg-mwa-burgundy/30 transition-all"
                style="width: 6px"
              />
            ))}
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .events-banner-track {
    scrollbar-width: none;
  }
  .events-banner-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function initEventsBanner(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>("[data-events-banner-track]");
    const dots = root.querySelectorAll<HTMLElement>("[data-events-banner-dot]");
    if (!track || dots.length < 2) return;

    const autoplayMs = Number(root.dataset.autoplayMs ?? 0);
    let userInteracted = false;
    let timer: number | null = null;

    const update = () => {
      const slideWidth = track.clientWidth;
      if (slideWidth === 0) return;
      const index = Math.round(track.scrollLeft / slideWidth);
      dots.forEach((dot, i) => {
        if (i === index) {
          dot.style.width = "18px";
          dot.classList.remove("bg-mwa-burgundy/30");
          dot.classList.add("bg-mwa-burgundy");
        } else {
          dot.style.width = "6px";
          dot.classList.add("bg-mwa-burgundy/30");
          dot.classList.remove("bg-mwa-burgundy");
        }
      });
    };

    const goTo = (index: number) => {
      track.scrollTo({ left: track.clientWidth * index, behavior: "smooth" });
    };

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        userInteracted = true;
        goTo(i);
      });
    });

    track.addEventListener("scroll", update, { passive: true });
    track.addEventListener("touchstart", () => (userInteracted = true), {
      passive: true,
    });
    track.addEventListener("pointerdown", () => (userInteracted = true));

    if (autoplayMs > 0) {
      timer = window.setInterval(() => {
        if (userInteracted) return;
        const slideWidth = track.clientWidth;
        if (slideWidth === 0) return;
        const index = Math.round(track.scrollLeft / slideWidth);
        const next = (index + 1) % dots.length;
        goTo(next);
      }, autoplayMs);
    }

    update();

    if (timer !== null) {
      document.addEventListener("visibilitychange", () => {
        if (document.hidden && timer !== null) {
          clearInterval(timer);
          timer = null;
        }
      });
    }
  }

  document
    .querySelectorAll<HTMLElement>("[data-events-banner]")
    .forEach(initEventsBanner);
</script>
