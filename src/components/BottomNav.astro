---
import { loadCurrentUser } from "../lib/auth";
import { countUserUnreadChat } from "../lib/db";

export type BottomTab = "home" | "news" | "chat" | "events" | "profile";

interface Props {
  active?: BottomTab;
}

const { active = "home" } = Astro.props;

const env = Astro.locals.runtime.env;
const me = await loadCurrentUser(
  env.DB,
  env.SESSIONS,
  Astro.request.headers.get("cookie"),
);
const chatUnread = me ? await countUserUnreadChat(env.DB, me.id) : 0;

const tabClass = (key: BottomTab) =>
  active === key ? "text-mwa-burgundy" : "text-gray-400";
const labelClass = (key: BottomTab) =>
  active === key
    ? "text-[11px] font-bold text-mwa-burgundy"
    : "text-[11px] font-medium text-gray-400";
---

<nav
  class="lg:hidden fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-white border-t border-gray-100 bottom-nav-shadow px-2 pb-6 pt-2 z-50"
  data-purpose="bottom-nav"
>
  <div class="flex items-center justify-around">
    <a href="/" class="flex flex-col items-center space-y-1 w-1/5">
      {
        active === "home" ? (
          <svg
            class={`w-6 h-6 ${tabClass("home")}`}
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
          </svg>
        ) : (
          <svg
            class={`w-6 h-6 ${tabClass("home")}`}
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3v-6h6v6h3a1 1 0 001-1V10"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            />
          </svg>
        )
      }
      <span class={labelClass("home")}>Нүүр</span>
    </a>

    <a href="/news" class="flex flex-col items-center space-y-1 w-1/5">
      <svg
        class={`w-6 h-6 ${tabClass("news")}`}
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
      <span class={labelClass("news")}>Мэдээ</span>
    </a>

    <a href="/chat" class="relative flex flex-col items-center space-y-1 w-1/5">
      {
        active === "chat" ? (
          <svg
            class={`w-6 h-6 ${tabClass("chat")}`}
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M4 4h16a2 2 0 012 2v10a2 2 0 01-2 2H8l-4 4V6a2 2 0 012-2z" />
          </svg>
        ) : (
          <svg
            class={`w-6 h-6 ${tabClass("chat")}`}
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            />
          </svg>
        )
      }
      <span class={labelClass("chat")}>Чат</span>
      {chatUnread > 0 && (
        <span class="absolute top-0 right-1/4 min-w-[18px] h-[18px] px-1 bg-mwa-burgundy text-white text-[10px] font-extrabold rounded-full flex items-center justify-center border-2 border-white shadow">
          {chatUnread > 99 ? "99+" : chatUnread}
        </span>
      )}
    </a>

    <a href="/events" class="flex flex-col items-center space-y-1 w-1/5">
      <svg
        class={`w-6 h-6 ${tabClass("events")}`}
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
      <span class={labelClass("events")}>Үйл явдал</span>
    </a>

    <a href="/profile" class="flex flex-col items-center space-y-1 w-1/5">
      <svg
        class={`w-6 h-6 ${tabClass("profile")}`}
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
      <span class={labelClass("profile")}>Профайл</span>
    </a>
  </div>
</nav>
