---
interface Props {
  title: string;
  subtitle?: string;
  variant?: "primary" | "secondary";
  href?: string;
}

const { title, subtitle, variant = "primary", href } = Astro.props;

const Tag = href ? "a" : "section";
---

{
  variant === "primary" ? (
    <section class="px-5 mb-8" data-purpose="hero-section">
      <Tag
        href={href}
        class="block bg-mwa-burgundy rounded-[24px] p-6 relative overflow-hidden min-h-[220px] flex flex-col justify-center text-white"
      >
        <div class="absolute right-0 top-0 h-full w-2/3 opacity-30 pointer-events-none">
          <svg class="h-full w-full" viewBox="0 0 100 100">
            <circle
              cx="90"
              cy="50"
              fill="none"
              r="45"
              stroke="white"
              stroke-width="0.2"
            />
            <path
              d="M60,20 Q85,20 85,50 Q85,80 60,80"
              fill="none"
              stroke="white"
              stroke-width="0.2"
            />
          </svg>
        </div>
        <div class="absolute right-[-10px] top-4 w-48 h-48 opacity-90">
          <svg fill="white" viewBox="0 0 200 200">
            <path
              d="M140,40 C110,40 90,60 90,90 C90,120 110,160 140,160 L140,160 C170,160 190,130 190,100 C190,70 170,40 140,40 Z"
              opacity="0.1"
            />
            <path
              d="M130,50 Q100,50 100,100 Q100,150 130,150"
              fill="none"
              stroke="white"
              stroke-width="1"
            />
            <circle cx="120" cy="90" fill="white" r="3" />
          </svg>
        </div>
        <div class="relative z-10 space-y-4">
          <h1 class="text-2xl font-bold leading-tight" set:html={title} />
          {subtitle && (
            <p
              class="text-sm font-light opacity-90"
              set:html={subtitle}
            />
          )}
        </div>
      </Tag>
    </section>
  ) : (
    <section class="px-5" data-purpose="secondary-banner">
      <Tag
        href={href}
        class="block bg-mwa-burgundy rounded-[24px] p-6 relative overflow-hidden flex items-center justify-between text-white"
      >
        <div class="relative z-10">
          <h3 class="text-xl font-bold mb-1">{title}</h3>
          {subtitle && <p class="text-sm opacity-80">{subtitle}</p>}
        </div>
        <div class="relative z-10">
          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M9 5l7 7-7 7"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            />
          </svg>
        </div>
        <div class="absolute right-[-20px] top-1/2 -translate-y-1/2 h-32 w-32 opacity-10">
          <img
            alt=""
            class="w-full h-full object-contain grayscale invert"
            src="/images/logo.png"
          />
        </div>
      </Tag>
    </section>
  )
}
