---
import { loadNotifications } from "../lib/notifications";
import { formatDateTime as fmtDateTimeKr } from "../lib/datetime";
import { countUserUnreadChat } from "../lib/db";
import { loadCurrentUser } from "../lib/auth";

const env = Astro.locals.runtime.env;
const me = await loadCurrentUser(
  env.DB,
  env.SESSIONS,
  Astro.request.headers.get("cookie"),
);
const chatUnread = me ? await countUserUnreadChat(env.DB, me.id) : 0;
const { items: notifications, latestAt } = await loadNotifications(env.DB);

interface MenuItem {
  label: string;
  href: string;
  icon: string;
}
interface MenuSection {
  title: string;
  items: MenuItem[];
}

const menuSections: MenuSection[] = [
  {
    title: "Үндсэн",
    items: [
      {
        label: "Нүүр",
        href: "/",
        icon: '<path d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3v-6h6v6h3a1 1 0 001-1V10" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
      },
      {
        label: "Мэдээ мэдээлэл",
        href: "/news",
        icon: '<path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10l4 4v10a2 2 0 01-2 2zM7 8h5m-5 4h5m-5 4h5" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
      },
      {
        label: "Үйл ажиллагаа",
        href: "/events",
        icon: '<path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
      },
      {
        label: "Хийгдсэн ажлууд",
        href: "/portfolio",
        icon: '<path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
      },
      {
        label: "Гишүүнчлэл",
        href: "/membership",
        icon: '<path d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6 5.87v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2m13-13a4 4 0 11-8 0 4 4 0 018 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
      },
      {
        label: "Зөвлөгөө, дэмжлэг",
        href: "/advice",
        icon: '<path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
      },
      {
        label: "Бидний тухай",
        href: "/about",
        icon: '<circle cx="12" cy="12" r="9" stroke-width="2"/><path d="M12 8h.01M11 12h1v4h1" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
      },
      {
        label: "Чат",
        href: "/chat",
        icon: '<path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
      },
    ],
  },
  {
    title: "Хувийн",
    items: [
      {
        label: "Профайл",
        href: "/profile",
        icon: '<path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
      },
      {
        label: "Хадгалсан мэдээ",
        href: "/profile/saved",
        icon: '<path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3-7 3V5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
      },
      {
        label: "Тохиргоо",
        href: "/profile/settings",
        icon: '<circle cx="12" cy="12" r="3" stroke-width="2"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>',
      },
    ],
  },
];

type DesktopTab = {
  href: string;
  label: string;
  active: (path: string) => boolean;
};

const path = Astro.url.pathname;

const desktopTabs: DesktopTab[] = [
  { href: "/", label: "Нүүр", active: (p) => p === "/" },
  {
    href: "/news",
    label: "Мэдээ",
    active: (p) => p === "/news" || p.startsWith("/news/"),
  },
  {
    href: "/events",
    label: "Үйл ажиллагаа",
    active: (p) => p === "/events" || p.startsWith("/events/"),
  },
  {
    href: "/portfolio",
    label: "Хийгдсэн ажлууд",
    active: (p) => p === "/portfolio",
  },
  {
    href: "/membership",
    label: "Гишүүнчлэл",
    active: (p) => p === "/membership" || p.startsWith("/membership/"),
  },
  { href: "/advice", label: "Зөвлөгөө", active: (p) => p === "/advice" },
  { href: "/about", label: "Бидний тухай", active: (p) => p === "/about" },
  {
    href: "/chat",
    label: "Чат",
    active: (p) => p === "/chat" || p.startsWith("/chat/"),
  },
  {
    href: "/profile",
    label: "Профайл",
    active: (p) => p === "/profile" || p.startsWith("/profile/"),
  },
];

function fmtAt(unix: number, kind: "news" | "event"): string {
  if (kind === "event") {
    // Event date — absolute, formatted in Asia/Seoul.
    return fmtDateTimeKr(unix);
  }
  // News — relative ("3 цагийн өмнө"), fall back to Seoul date for older entries.
  const now = Date.now() / 1000;
  const diff = Math.max(0, Math.floor(now - unix));
  if (diff < 60) return "Дөнгөж сая";
  if (diff < 3600) return `${Math.floor(diff / 60)} минутын өмнө`;
  if (diff < 86400) return `${Math.floor(diff / 3600)} цагийн өмнө`;
  if (diff < 7 * 86400) return `${Math.floor(diff / 86400)} өдрийн өмнө`;
  return fmtDateTimeKr(unix).slice(0, 10);
}
---

<header
  class="px-5 lg:px-12 pt-6 lg:pt-5 pb-4 lg:pb-4 flex items-center justify-between lg:bg-mwa-cream lg:border-b lg:border-mwa-ink/90"
  data-purpose="top-header"
>
  <a href="/" class="flex items-center gap-3">
    <img
      alt="MWA Logo"
      class="w-16 h-16 lg:w-11 lg:h-11 object-contain"
      src="/images/logo.png"
    />
    <div class="flex flex-col leading-tight">
      <span class="text-mwa-burgundy font-bold text-lg lg:text-[11px] lg:tracking-[0.2em] lg:uppercase lg:text-mwa-ink/70 lg:font-extrabold"
        >БНСУ дахь</span
      >
      <span class="text-mwa-burgundy font-bold text-lg lg:text-[15px] lg:font-extrabold lg:text-mwa-ink lg:tracking-tight"
        >салбар зөвлөл</span
      >
    </div>
  </a>

  <div class="flex items-center gap-1">
    <button
      aria-label="Мэдэгдэл"
      class="relative p-2"
      data-notif-toggle
      data-latest-at={String(latestAt)}
      aria-expanded="false"
      aria-controls="notif-panel"
    >
      <svg
        class="h-7 w-7 text-gray-800"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"></path>
      </svg>
      <span
        class="absolute top-2 right-2 w-2.5 h-2.5 bg-mwa-burgundy border-2 border-white rounded-full hidden"
        data-notif-dot></span>
    </button>

    <button
      aria-label="Меню"
      class="p-2 lg:hidden"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="main-menu-panel"
    >
      <svg
        class="h-7 w-7 text-gray-800"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M4 7h16M4 12h16M4 17h16"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"></path>
      </svg>
    </button>
  </div>
</header>

{/* ---------- Desktop primary navigation ---------- */}
<nav
  class="hidden lg:flex items-center justify-center gap-2 px-12 py-2.5 bg-mwa-cream border-b border-mwa-ink/90"
  aria-label="Үндсэн цэс"
>
  {
    desktopTabs.map((t) => {
      const isActive = t.active(path);
      const showBadge = t.href === "/chat" && chatUnread > 0;
      return (
        <a
          href={t.href}
          class={`relative px-3 py-1.5 text-[13px] font-semibold tracking-wide transition-colors ${
            isActive
              ? "text-mwa-burgundy"
              : "text-mwa-ink hover:text-mwa-burgundy"
          }`}
        >
          {t.label}
          {isActive && (
            <span class="absolute left-3 right-3 -bottom-[7px] h-0.5 bg-mwa-burgundy" />
          )}
          {showBadge && (
            <span class="ml-1.5 inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 bg-mwa-burgundy text-white text-[10px] font-extrabold rounded-full align-middle">
              {chatUnread > 99 ? "99+" : chatUnread}
            </span>
          )}
        </a>
      );
    })
  }
</nav>

{/* ---------- Notification panel ---------- */}
<div
  class="fixed inset-0 z-[60] pointer-events-none"
  data-notif-root
  aria-hidden="true"
>
  <div
    class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-200"
    data-notif-backdrop>
  </div>

  <aside
    id="notif-panel"
    class="absolute top-0 right-0 bottom-0 w-80 max-w-[85vw] bg-white shadow-2xl transform translate-x-full transition-transform duration-300 ease-out flex flex-col"
    data-notif-panel
    role="dialog"
    aria-label="Мэдэгдэл"
  >
    <div
      class="px-5 pt-6 pb-4 flex items-center justify-between border-b border-gray-100"
    >
      <h2 class="font-extrabold text-base">Мэдэгдэл</h2>
      <button aria-label="Хаах" class="p-2 -mr-2" data-notif-close>
        <svg
          class="h-6 w-6 text-mwa-text-primary"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M6 18L18 6M6 6l12 12"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"></path>
        </svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto">
      {
        notifications.length === 0 ? (
          <div class="px-5 py-10 text-center text-sm text-gray-400">
            Мэдэгдэл алга байна.
          </div>
        ) : (
          <ul class="divide-y divide-gray-100">
            {notifications.map((n) => (
              <li>
                <a
                  href={n.href}
                  class="flex items-start gap-3 px-5 py-3 active:bg-gray-50 hover:bg-gray-50 transition"
                  data-notif-item
                  data-at={String(n.at)}
                >
                  <div class="w-11 h-11 shrink-0 rounded-xl overflow-hidden bg-gray-100 relative flex items-center justify-center">
                    {n.thumbnail ? (
                      <img
                        src={n.thumbnail}
                        alt=""
                        loading="lazy"
                        class="w-full h-full object-cover"
                      />
                    ) : n.kind === "event" ? (
                      <span class="text-lg">📅</span>
                    ) : (
                      <span class="text-lg">📰</span>
                    )}
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-1.5 mb-0.5">
                      <span
                        class={`text-[10px] font-bold px-1.5 py-0.5 rounded ${
                          n.kind === "event"
                            ? "bg-rose-100 text-rose-700"
                            : "bg-blue-100 text-blue-700"
                        }`}
                      >
                        {n.kind === "event" ? "Арга хэмжээ" : "Мэдээ"}
                      </span>
                      <span class="text-[10px] text-gray-400">
                        {fmtAt(n.at, n.kind)}
                      </span>
                      <span
                        class="ml-auto w-1.5 h-1.5 rounded-full bg-mwa-burgundy hidden"
                        data-notif-unread
                      />
                    </div>
                    <div class="text-sm font-semibold leading-tight line-clamp-2 text-mwa-text-primary">
                      {n.title}
                    </div>
                    {n.subtitle && (
                      <div class="text-[11px] text-gray-500 mt-0.5 line-clamp-1">
                        {n.subtitle}
                      </div>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="border-t border-gray-100 px-5 py-3 grid grid-cols-2 gap-2">
      <a
        href="/news"
        class="text-center text-xs font-bold text-mwa-burgundy py-2 rounded-xl border border-mwa-burgundy/30 active:bg-mwa-burgundy/5"
      >
        Бүх мэдээ
      </a>
      <a
        href="/events"
        class="text-center text-xs font-bold text-mwa-burgundy py-2 rounded-xl border border-mwa-burgundy/30 active:bg-mwa-burgundy/5"
      >
        Бүх арга хэмжээ
      </a>
    </div>
  </aside>
</div>

{/* ---------- Main side menu ---------- */}
<div
  class="fixed inset-0 z-[60] pointer-events-none"
  data-menu-root
  aria-hidden="true"
>
  <div
    class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-200"
    data-menu-backdrop
  >
  </div>

  <aside
    id="main-menu-panel"
    class="absolute top-0 right-0 bottom-0 w-80 max-w-[85vw] bg-white shadow-2xl transform translate-x-full transition-transform duration-300 ease-out flex flex-col"
    data-menu-panel
    role="dialog"
    aria-label="Үндсэн меню"
  >
    <div
      class="px-5 pt-6 pb-4 flex items-center justify-between border-b border-gray-100"
    >
      <h2 class="font-extrabold text-base">Меню</h2>
      <button aria-label="Хаах" class="p-2 -mr-2" data-menu-close>
        <svg
          class="h-6 w-6 text-mwa-text-primary"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M6 18L18 6M6 6l12 12"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"></path>
        </svg>
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto py-2">
      {
        menuSections.map((section) => (
          <div class="py-2">
            <div class="px-5 text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">
              {section.title}
            </div>
            {section.items.map((item) => (
              <a
                href={item.href}
                class="flex items-center gap-3 px-5 py-3 active:bg-gray-50"
              >
                <svg
                  class="w-5 h-5 text-mwa-text-secondary shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  set:html={item.icon}
                />
                <span class="text-sm text-mwa-text-primary">{item.label}</span>
              </a>
            ))}
          </div>
        ))
      }
    </nav>

    <div class="border-t border-gray-100 px-5 py-4">
      <a
        href="/profile/login?next=/"
        class="block text-center bg-mwa-burgundy text-white font-bold rounded-2xl py-3 text-sm active:opacity-80"
      >
        Нэвтрэх
      </a>
    </div>
  </aside>
</div>

<script>
  type DrawerEls = {
    toggle: HTMLButtonElement;
    root: HTMLElement;
    backdrop: HTMLElement;
    panel: HTMLElement;
    close: HTMLButtonElement;
  };

  function wireDrawer(els: DrawerEls, onOpen?: () => void) {
    const { toggle, root, backdrop, panel, close } = els;
    const open = () => {
      root.classList.remove("pointer-events-none");
      root.setAttribute("aria-hidden", "false");
      toggle.setAttribute("aria-expanded", "true");
      requestAnimationFrame(() => {
        backdrop.classList.remove("opacity-0");
        backdrop.classList.add("opacity-100");
        panel.classList.remove("translate-x-full");
        panel.classList.add("translate-x-0");
      });
      document.body.style.overflow = "hidden";
      onOpen?.();
    };
    const doClose = () => {
      backdrop.classList.add("opacity-0");
      backdrop.classList.remove("opacity-100");
      panel.classList.add("translate-x-full");
      panel.classList.remove("translate-x-0");
      toggle.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      window.setTimeout(() => {
        root.classList.add("pointer-events-none");
        root.setAttribute("aria-hidden", "true");
      }, 300);
    };
    toggle.addEventListener("click", open);
    close.addEventListener("click", doClose);
    backdrop.addEventListener("click", doClose);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        doClose();
      }
    });
    return { open, doClose };
  }

  // ---------- Menu drawer ----------
  {
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const root = document.querySelector<HTMLElement>("[data-menu-root]");
    const backdrop = document.querySelector<HTMLElement>("[data-menu-backdrop]");
    const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
    const close = document.querySelector<HTMLButtonElement>("[data-menu-close]");
    if (toggle && root && backdrop && panel && close) {
      wireDrawer({ toggle, root, backdrop, panel, close });
    }
  }

  // ---------- Notification drawer ----------
  {
    const toggle = document.querySelector<HTMLButtonElement>("[data-notif-toggle]");
    const root = document.querySelector<HTMLElement>("[data-notif-root]");
    const backdrop = document.querySelector<HTMLElement>("[data-notif-backdrop]");
    const panel = document.querySelector<HTMLElement>("[data-notif-panel]");
    const close = document.querySelector<HTMLButtonElement>("[data-notif-close]");
    const dot = document.querySelector<HTMLElement>("[data-notif-dot]");
    const items = document.querySelectorAll<HTMLElement>("[data-notif-item]");

    const SEEN_KEY = "mwa.notif.lastSeenAt";

    function readSeen(): number {
      try {
        return Number(localStorage.getItem(SEEN_KEY) ?? "0") || 0;
      } catch {
        return 0;
      }
    }
    function writeSeen(unix: number) {
      try {
        localStorage.setItem(SEEN_KEY, String(unix));
      } catch {
        // storage blocked — fall back silently
      }
    }

    if (toggle && root && backdrop && panel && close && dot) {
      const latestAt = Number(toggle.dataset.latestAt ?? "0") || 0;
      const seen = readSeen();

      // Show the dot if anything is newer than the last open.
      if (latestAt > seen) dot.classList.remove("hidden");

      // Mark individual items as "unread" if newer than seen.
      items.forEach((item) => {
        const at = Number(item.dataset.at ?? "0") || 0;
        const unread = item.querySelector<HTMLElement>("[data-notif-unread]");
        if (unread && at > seen) unread.classList.remove("hidden");
      });

      wireDrawer({ toggle, root, backdrop, panel, close }, () => {
        // On open: mark everything as seen and clear the dot.
        writeSeen(Math.floor(Date.now() / 1000));
        dot.classList.add("hidden");
      });
    }
  }
</script>
