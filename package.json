{
  "name": "mwa-korea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist",
    "deploy": "wrangler pages deploy ./dist",
    "astro": "astro",
    "db:local": "wrangler d1 execute mwa-korea-db --local --file=./db/schema.sql",
    "db:seed:local": "wrangler d1 execute mwa-korea-db --local --file=./db/seed.sql",
    "db:remote": "wrangler d1 execute mwa-korea-db --remote --file=./db/schema.sql",
    "db:seed:remote": "wrangler d1 execute mwa-korea-db --remote --file=./db/seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@types/sortablejs": "^1.15.9",
    "astro": "^5.18.0",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^4.20251001.0",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.114.0"
  }
}
